#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Installed for the switch offloads, off until asked for: lldpd would
# send LLDP on every link and wpad would run an idle hostapd. Removing
# the links here (S10boot) also keeps them out of the first boot.
for svc in lldpd wpad; do
	[ -x "/etc/init.d/$svc" ] && "/etc/init.d/$svc" disable 2>/dev/null
done
exit 0
