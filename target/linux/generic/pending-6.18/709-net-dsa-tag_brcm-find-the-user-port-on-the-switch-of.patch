From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: [PATCH] net: dsa: tag_brcm: find the user port on the switch of the CPU port

The receive paths look the source port up on switch 0 of the tree. In a
tree of two switches with a CPU port each (FortiGate 90D: two BCM53128,
one on each link of the network processor, joined by a cascade), a frame
of switch 1 would be handed to the port of the same number of switch 0.
Look the port up on the switch of the CPU port the frame came in by,
dev->dsa_ptr; unchanged for a tree of one switch. A frame whose source
port is the cascade (a DSA port) still finds no user port and is
dropped: the copy the other switch floods across the cascade.
Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 net/dsa/tag_brcm.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

--- a/net/dsa/tag_brcm.c
+++ b/net/dsa/tag_brcm.c
@@ -148,6 +148,7 @@ static struct sk_buff *brcm_tag_rcv_ll(s
 				       struct net_device *dev,
 				       unsigned int offset)
 {
+	struct dsa_port *cpu_dp = dev->dsa_ptr;
 	int source_port;
 	u8 *brcm_tag;
 
@@ -169,7 +170,8 @@ static struct sk_buff *brcm_tag_rcv_ll(s
 	/* Locate which port this is coming from */
 	source_port = brcm_tag[3] & BRCM_EG_PID_MASK;
 
-	skb->dev = dsa_conduit_find_user(dev, 0, source_port);
+	skb->dev = dsa_conduit_find_user(dev, cpu_dp->ds->index,
+					 source_port);
 	if (!skb->dev)
 		return NULL;
 
@@ -223,6 +225,7 @@ MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROT
 static struct sk_buff *brcm_leg_tag_rcv(struct sk_buff *skb,
 					struct net_device *dev)
 {
+	struct dsa_port *cpu_dp = dev->dsa_ptr;
 	int len = BRCM_LEG_TAG_LEN;
 	int source_port;
 	__be16 *proto;
@@ -236,7 +239,8 @@ static struct sk_buff *brcm_leg_tag_rcv(
 
 	source_port = brcm_tag[5] & BRCM_LEG_PORT_ID;
 
-	skb->dev = dsa_conduit_find_user(dev, 0, source_port);
+	skb->dev = dsa_conduit_find_user(dev, cpu_dp->ds->index,
+					 source_port);
 	if (!skb->dev)
 		return NULL;
 
