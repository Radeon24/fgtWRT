From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: [PATCH] net: dsa: b53: add link aggregation offload for the BCM53128

Add NET_DSA_B53_LAG: trunk groups of the BCM53128.
Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 drivers/net/dsa/b53/Kconfig      |  13 ++
 drivers/net/dsa/b53/b53_common.c | 224 ++++++++++++++++++++++++++++++++
 drivers/net/dsa/b53/b53_priv.h   |  17 ++
 drivers/net/dsa/b53/b53_regs.h   |  23 +++
 4 files changed, 277 insertions(+)

--- a/drivers/net/dsa/b53/Kconfig
+++ b/drivers/net/dsa/b53/Kconfig
@@ -12,6 +12,19 @@ menuconfig B53
 	  BCM5325E, BCM5365, BCM539x, BCM53115 and BCM53125 as well as BCM63XX
 	  integrated switches.
 
+config NET_DSA_B53_LAG
+	bool "B53 link aggregation offload (BCM53128 only)"
+	depends on B53
+	help
+	  Offload hash based link aggregation groups (bonding balance-xor
+	  and 802.3ad, the LACP state machine staying in software) to the
+	  trunking hardware of the BCM53128: two groups of up to four ports
+	  of the same speed. The trunk registers are cleared at setup and
+	  teardown. Other switches keep software aggregation.
+
+	  Without this option, the driver never accesses the trunk
+	  registers. If unsure, say N.
+
 config B53_SPI_DRIVER
 	tristate "B53 SPI connected switch driver"
 	depends on B53 && SPI
--- a/drivers/net/dsa/b53/b53_common.c
+++ b/drivers/net/dsa/b53/b53_common.c
@@ -1252,6 +1252,211 @@ out:
 }
 EXPORT_SYMBOL(b53_setup_devlink_resources);
 
+#if IS_ENABLED(CONFIG_NET_DSA_B53_LAG)
+/* BCM53128 trunking (datasheet 53128-DS07-R, "Port Trunking/Aggregation"
+ * and page 32h): two groups of up to four ports of the same link speed,
+ * a global MAC address hash, automatic failover inside a group. The
+ * three registers are fully determined by the DSA LAG state: they are
+ * rewritten whole on every change, and cleared at setup and teardown
+ * since the chip is not reset by b53_reset_switch().
+ */
+static void b53_lag_write(struct b53_device *dev,
+			  const u16 groups[B53_NUM_TRUNKS])
+{
+	bool enable = false;
+	unsigned int i;
+	u16 grp;
+	u8 ctl;
+
+	for (i = 0; i < B53_NUM_TRUNKS; i++)
+		if (groups[i])
+			enable = true;
+
+	b53_read8(dev, B53_TRUNK_PAGE, B53_MAC_TRUNK_CTL, &ctl);
+	ctl &= ~(MAC_BASE_TRNK_EN | MAC_TRUNK_HASH_MASK);
+	ctl |= MAC_TRUNK_HASH_DA_SA;
+
+	/* Turn trunking off before emptying the groups */
+	if (!enable)
+		b53_write8(dev, B53_TRUNK_PAGE, B53_MAC_TRUNK_CTL, ctl);
+
+	for (i = 0; i < B53_NUM_TRUNKS; i++) {
+		b53_read16(dev, B53_TRUNK_PAGE, B53_TRUNK_GRP(i), &grp);
+		grp &= ~TRUNK_GRP_MASK;
+		/* Never the IMP port: frames to the CPU would be hashed away */
+		grp |= groups[i] & TRUNK_GRP_MASK & ~TRUNK_GRP_IMP;
+		b53_write16(dev, B53_TRUNK_PAGE, B53_TRUNK_GRP(i), grp);
+	}
+
+	if (enable) {
+		ctl |= MAC_BASE_TRNK_EN;
+		b53_write8(dev, B53_TRUNK_PAGE, B53_MAC_TRUNK_CTL, ctl);
+	}
+}
+
+static void b53_lag_clear(struct b53_device *dev, bool setup)
+{
+	static const u16 none[B53_NUM_TRUNKS];
+	u16 grp0, grp1;
+	u8 ctl, vc5;
+
+	if (setup) {
+		b53_read8(dev, B53_TRUNK_PAGE, B53_MAC_TRUNK_CTL, &ctl);
+		b53_read16(dev, B53_TRUNK_PAGE, B53_TRUNK_GRP(0), &grp0);
+		b53_read16(dev, B53_TRUNK_PAGE, B53_TRUNK_GRP(1), &grp1);
+		if (ctl || grp0 || grp1)
+			dev_info(dev->dev,
+				 "trunk control 0x%02x, groups 0x%03x 0x%03x left set, clearing\n",
+				 ctl, grp0, grp1);
+
+		/* Frames the IMP port directs to a port must leave on that
+		 * port, whatever the trunks: LACPDUs and the bond's own
+		 * hashing depend on it. This is the reset value; do not rely
+		 * on it.
+		 */
+		b53_read8(dev, B53_VLAN_PAGE, B53_VLAN_CTRL5, &vc5);
+		if (!(vc5 & VC5_TRUNK_CHK_BYPASS))
+			b53_write8(dev, B53_VLAN_PAGE, B53_VLAN_CTRL5,
+				   vc5 | VC5_TRUNK_CHK_BYPASS);
+	}
+
+	b53_lag_write(dev, none);
+}
+
+/* Members of a LAG the chip may hash to: the distributing ones, all at
+ * the same speed. When speeds differ, keep the most common one (the
+ * highest on a tie). A single member makes no trunk.
+ */
+static u16 b53_lag_members(struct dsa_switch *ds, struct dsa_lag *lag)
+{
+	struct b53_device *dev = ds->priv;
+	int speed = 0, best = 0, s, n;
+	struct dsa_port *dp, *other;
+	u16 members = 0;
+
+	dsa_lag_foreach_port(dp, ds->dst, lag) {
+		if (dp->ds != ds || !dp->lag_tx_enabled)
+			continue;
+
+		s = READ_ONCE(dev->ports[dp->index].speed);
+		if (s <= 0)
+			continue;
+
+		n = 0;
+		dsa_lag_foreach_port(other, ds->dst, lag)
+			if (other->ds == ds && other->lag_tx_enabled &&
+			    READ_ONCE(dev->ports[other->index].speed) == s)
+				n++;
+
+		if (n > best || (n == best && s > speed)) {
+			best = n;
+			speed = s;
+		}
+	}
+
+	if (best < 2)
+		return 0;
+
+	dsa_lag_foreach_port(dp, ds->dst, lag)
+		if (dp->ds == ds && dp->lag_tx_enabled &&
+		    READ_ONCE(dev->ports[dp->index].speed) == speed)
+			members |= BIT(dp->index);
+
+	return members;
+}
+
+static void b53_lag_sync(struct dsa_switch *ds)
+{
+	u16 groups[B53_NUM_TRUNKS] = { 0 };
+	struct dsa_lag *lag;
+	unsigned int id;
+
+	dsa_lags_foreach_id(id, ds->dst) {
+		/* DSA LAG IDs are one-based, trunk groups zero-based */
+		if (id > B53_NUM_TRUNKS)
+			break;
+
+		lag = dsa_lag_by_id(ds->dst, id);
+		groups[id - 1] = b53_lag_members(ds, lag);
+	}
+
+	b53_lag_write(ds->priv, groups);
+}
+
+static bool b53_lag_can_offload(struct dsa_switch *ds, struct dsa_lag lag,
+				struct netdev_lag_upper_info *info,
+				struct netlink_ext_ack *extack)
+{
+	struct b53_device *dev = ds->priv;
+	struct dsa_port *dp;
+	int members = 0;
+
+	if (!b53_has_trunk(dev))
+		return false;
+
+	if (!lag.id || lag.id > B53_NUM_TRUNKS) {
+		NL_SET_ERR_MSG_MOD(extack, "No free trunk group");
+		return false;
+	}
+
+	if (info->tx_type != NETDEV_LAG_TX_TYPE_HASH) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Can only offload LAG using hash TX type");
+		return false;
+	}
+
+	dsa_lag_foreach_port(dp, ds->dst, &lag) {
+		/* Includes the port joining the LAG */
+		if (dp->ds != ds || !dsa_port_is_user(dp) ||
+		    dp->index == dev->imp_port) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Can only offload LAG of user ports");
+			return false;
+		}
+		members++;
+	}
+
+	if (members > B53_TRUNK_MAX_PORTS) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Cannot offload more than 4 LAG ports");
+		return false;
+	}
+
+	return true;
+}
+
+static int b53_lag_join(struct dsa_switch *ds, int port, struct dsa_lag lag,
+			struct netdev_lag_upper_info *info,
+			struct netlink_ext_ack *extack)
+{
+	if (!b53_lag_can_offload(ds, lag, info, extack))
+		return -EOPNOTSUPP;
+
+	/* The port distributes only once its bond says so */
+	b53_lag_sync(ds);
+
+	return 0;
+}
+
+static int b53_lag_leave(struct dsa_switch *ds, int port, struct dsa_lag lag)
+{
+	b53_lag_sync(ds);
+
+	return 0;
+}
+
+static int b53_lag_change(struct dsa_switch *ds, int port)
+{
+	b53_lag_sync(ds);
+
+	return 0;
+}
+#else
+static inline void b53_lag_clear(struct b53_device *dev, bool setup)
+{
+}
+#endif /* CONFIG_NET_DSA_B53_LAG */
+
 static int b53_setup(struct dsa_switch *ds)
 {
 	struct b53_device *dev = ds->priv;
@@ -1303,6 +1508,11 @@ static int b53_setup(struct dsa_switch *
 		return ret;
 	}
 
+	if (b53_has_trunk(dev)) {
+		b53_lag_clear(dev, true);
+		ds->num_lag_ids = B53_NUM_TRUNKS;
+	}
+
 	/* Configure IMP/CPU port, disable all other ports. Enabled
 	 * ports will be configured with .port_enable
 	 */
@@ -1318,6 +1528,11 @@ static int b53_setup(struct dsa_switch *
 
 static void b53_teardown(struct dsa_switch *ds)
 {
+	struct b53_device *dev = ds->priv;
+
+	if (b53_has_trunk(dev))
+		b53_lag_clear(dev, false);
+
 	dsa_devlink_resources_unregister(ds);
 }
 
@@ -1599,6 +1814,8 @@ static void b53_phylink_mac_link_down(st
 	struct b53_device *dev = dp->ds->priv;
 	int port = dp->index;
 
+	b53_lag_set_speed(dev, port, 0);
+
 	if (mode == MLO_AN_PHY) {
 		if (is63xx(dev) && in_range(port, B53_63XX_RGMII0, 4))
 			b53_force_link(dev, port, false);
@@ -1628,6 +1845,8 @@ static void b53_phylink_mac_link_up(stru
 	struct ethtool_keee *p = &dev->ports[dp->index].eee;
 	int port = dp->index;
 
+	b53_lag_set_speed(dev, port, speed);
+
 	if (mode == MLO_AN_PHY) {
 		/* Re-negotiate EEE if it was enabled already */
 		p->eee_enabled = b53_eee_init(ds, port, phydev);
@@ -2709,6 +2928,11 @@ static const struct dsa_switch_ops b53_s
 	.port_mdb_del		= b53_mdb_del,
 	.port_max_mtu		= b53_get_max_mtu,
 	.port_change_mtu	= b53_change_mtu,
+#if IS_ENABLED(CONFIG_NET_DSA_B53_LAG)
+	.port_lag_join		= b53_lag_join,
+	.port_lag_leave		= b53_lag_leave,
+	.port_lag_change	= b53_lag_change,
+#endif
 };
 
 static const struct b53_arl_ops b53_arl_ops_25 = {
--- a/drivers/net/dsa/b53/b53_priv.h
+++ b/drivers/net/dsa/b53/b53_priv.h
@@ -121,6 +121,9 @@ struct b53_port {
 	u16		vlan_ctl_mask;
 	u16		pvid;
 	struct ethtool_keee eee;
+#if IS_ENABLED(CONFIG_NET_DSA_B53_LAG)
+	int		speed;		/* link speed, 0 when down */
+#endif
 };
 
 struct b53_vlan {
@@ -233,6 +236,20 @@ static inline int is531x5(struct b53_dev
 		dev->chip_id == BCM53134_DEVICE_ID;
 }
 
+static inline bool b53_has_trunk(struct b53_device *dev)
+{
+	return IS_ENABLED(CONFIG_NET_DSA_B53_LAG) &&
+	       dev->chip_id == BCM53128_DEVICE_ID;
+}
+
+static inline void b53_lag_set_speed(struct b53_device *dev, int port,
+				     int speed)
+{
+#if IS_ENABLED(CONFIG_NET_DSA_B53_LAG)
+	WRITE_ONCE(dev->ports[port].speed, speed);
+#endif
+}
+
 static inline int is63xx(struct b53_device *dev)
 {
 	return dev->chip_id == BCM63XX_DEVICE_ID ||
--- a/drivers/net/dsa/b53/b53_regs.h
+++ b/drivers/net/dsa/b53/b53_regs.h
@@ -45,6 +45,9 @@
 /* Port VLAN Page */
 #define B53_PVLAN_PAGE			0x31
 
+/* Trunking Registers */
+#define B53_TRUNK_PAGE			0x32
+
 /* VLAN Registers */
 #define B53_VLAN_PAGE			0x34
 
@@ -485,6 +488,7 @@
 #define B53_VLAN_CTRL5_63XX		0x07
 #define   VC5_VID_FFF_EN		BIT(2)
 #define   VC5_DROP_VTABLE_MISS		BIT(3)
+#define   VC5_TRUNK_CHK_BYPASS		BIT(4) /* BCM53128 */
 
 /* VLAN Control 6 (8 bit) */
 #define B53_VLAN_CTRL6			0x07
@@ -587,6 +591,25 @@
 
 
 /*************************************************************************
+ * Trunking Page Registers (BCM53128)
+ *************************************************************************/
+
+/* MAC Trunk Control Register (8 bit) */
+#define B53_MAC_TRUNK_CTL		0x00
+#define   MAC_TRUNK_HASH_MASK		0x3
+#define   MAC_TRUNK_HASH_DA_SA		0 /* 3 is an illegal state */
+#define   MAC_TRUNK_HASH_DA		1
+#define   MAC_TRUNK_HASH_SA		2
+#define   MAC_BASE_TRNK_EN		BIT(3)
+
+/* Trunk Group Register (16 bit), bit 8 is the IMP port */
+#define B53_TRUNK_GRP(i)		(0x10 + 2 * (i))
+#define   TRUNK_GRP_MASK		0x1ff
+#define   TRUNK_GRP_IMP			BIT(8)
+#define B53_NUM_TRUNKS			2
+#define B53_TRUNK_MAX_PORTS		4
+
+/*************************************************************************
  * CFP Configuration Page Registers
  *************************************************************************/
 
