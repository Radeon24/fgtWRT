From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: [PATCH] mmc: core: write windows in the fortinet,force-ro guard, armed at run time

Optional (MMC_WRITE_WINDOWS, default n): sector windows of the
force-ro guard, read from the fortinet,write-windows property of the
guarded host, disarmed at boot and armed once per boot through the
write_windows parameter, for the installer of a second firmware slot.
A write of sector 0 may only change the bytes listed by
fortinet,sector0-bytes, compared with a copy read at arming time.
Optional persistent windows (fortinet,persistent-windows) are open from
boot without arming, for a file system kept in that slot, until "off";
a refused PARTITION_CONFIG switch closes every window. Also refuse data
writes through the block ioctl under the guard, window or not.

The code lives in drivers/mmc/core/write-windows.c (files of the
target); this patch hooks it up (core, host, block driver for the disk
of the user area).

Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 drivers/mmc/core/Kconfig  |   32 ++++++++++++++++++++++++++++++++
 drivers/mmc/core/block.c  |   10 +++++++++-
 drivers/mmc/core/core.c   |   19 ++++++++++++++++---
 drivers/mmc/core/core.h   |    2 ++
 drivers/mmc/core/host.c   |    9 +++++++++
 drivers/mmc/core/queue.c  |    4 ++++
 drivers/mmc/core/Makefile |    1 +
 7 files changed, 73 insertions(+), 4 deletions(-)

--- a/drivers/mmc/core/Kconfig
+++ b/drivers/mmc/core/Kconfig
@@ -34,6 +34,38 @@
 	  This driver can also be built as a module. If so, the module
 	  will be called pwrseq_simple.
 
+config MMC_WRITE_WINDOWS
+	bool "Write windows in the fortinet,force-ro guard, armed at run time"
+	depends on MMC && BLOCK
+	default n
+	help
+	  The read-only guard of hosts marked "fortinet,force-ro" refuses
+	  every write. With this option, plain CMD24/CMD25 writes of 512-byte
+	  blocks to the user area of a sector-addressed eMMC may be let
+	  through when the whole request lies inside one of the windows
+	  given by the "fortinet,write-windows" property of the host
+	  (<start count> pairs of 512-byte sectors). A guarded host without
+	  windows stays strictly read-only.
+
+	  The windows are disarmed at boot: every write stays refused until
+	  user space (the installer) writes "arm" to
+	  /sys/module/mmc_core/parameters/write_windows. They can be armed
+	  once per boot, for 10 minutes at most; writing "off" (end of the
+	  installation) or a refused PARTITION_CONFIG switch turns them off
+	  until the next boot. A write of sector 0 may only change the bytes
+	  listed by "fortinet,sector0-bytes", compared with a copy of
+	  sector 0 read at arming time.
+
+	  Optional persistent windows ("fortinet,persistent-windows") are
+	  open from boot without arming, for a file system kept in a
+	  firmware slot, until "off"; the end of the armed time leaves them
+	  open ("expired").
+	  The parameter reads "inactive", "disarmed ...", "armed ...",
+	  "expired ..." or "off". Erase, discard, EXT_CSD writes, boot/RPMB
+	  partitions, the command queue engine and ioctl writes stay refused.
+
+	  For an installer writing one firmware slot of an eMMC. Say N.
+
 config MMC_BLOCK
 	tristate "MMC block device driver"
 	depends on BLOCK
--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -497,6 +497,10 @@
 	if (idata->flags & MMC_BLK_IOC_DROP)
 		return 0;
 
+	/* Read-only guard: no data write through the ioctl, window or not */
+	if ((card->host->caps2 & MMC_CAP2_FORCE_RO) && idata->ic.write_flag)
+		return -EROFS;
+
 	if (idata->flags & MMC_BLK_IOC_SBC && i > 0)
 		prev_idata = idatas[i - 1];
 
@@ -2490,7 +2494,8 @@
 static inline int mmc_blk_readonly(struct mmc_card *card)
 {
 	return mmc_card_readonly(card) ||
-	       (card->host->caps2 & MMC_CAP2_FORCE_RO) ||
+	       ((card->host->caps2 & MMC_CAP2_FORCE_RO) &&
+		!mmc_write_windows_on_host(card->host)) ||
 	       !(card->csd.cmdclass & CCC_BLOCK_WRITE);
 }
 
@@ -3058,6 +3063,7 @@
 	 * Flush remaining requests and free queues. It is freeing the queue
 	 * that stops new requests from being accepted.
 	 */
+	mmc_write_windows_remove_disk(md->disk);
 	del_gendisk(md->disk);
 	mmc_cleanup_queue(&md->queue);
 	mmc_blk_put(md);
@@ -3299,6 +3305,8 @@
 		ret = PTR_ERR(md);
 		goto out_free;
 	}
+	/* Read-only guard: the disk of the user area of its windows */
+	mmc_write_windows_add_disk(card->host, md->disk);
 
 	ret = mmc_blk_alloc_parts(card, md);
 	if (ret)
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -267,9 +267,16 @@
 {
 	struct mmc_command *bad = NULL;
 
-	if (mrq->data && (mrq->data->flags & MMC_DATA_WRITE))
-		bad = mrq->cmd;
-	else if (mrq->sbc && !mmc_force_ro_cmd_ok(mrq->sbc))
+	/*
+	 * Any data that is not a plain read is a write for the host driver
+	 * (tmio: !MMC_DATA_READ means write): refused unless it is a CMD24/25
+	 * entirely inside a write window (write-windows.c).
+	 */
+	if (mrq->data && ((mrq->data->flags & MMC_DATA_WRITE) ||
+			  !(mrq->data->flags & MMC_DATA_READ))) {
+		if (!mmc_write_window_ok(host, mrq))
+			bad = mrq->cmd;
+	} else if (mrq->sbc && !mmc_force_ro_cmd_ok(mrq->sbc))
 		bad = mrq->sbc;
 	else if (mrq->stop && mrq->stop->opcode != MMC_STOP_TRANSMISSION)
 		bad = mrq->stop;
@@ -278,6 +285,8 @@
 	if (!bad)
 		return 0;
 
+	mmc_write_windows_note_refused(bad);
+
 	pr_warn_ratelimited("%s: force-ro: CMD%u arg %#010x refused\n",
 			    mmc_hostname(host), bad->opcode, bad->arg);
 	/*
@@ -525,6 +534,10 @@
 {
 	int err;
 
+	/* Read-only guard: the command queue engine bypasses it, never used */
+	if (unlikely(host->caps2 & MMC_CAP2_FORCE_RO))
+		return -EROFS;
+
 	/*
 	 * CQE cannot process re-tuning commands. Caller must hold retuning
 	 * while CQE is in use.  Re-tuning can happen here only when CQE has no
--- a/drivers/mmc/core/core.h
+++ b/drivers/mmc/core/core.h
@@ -11,6 +11,8 @@
 #include <linux/delay.h>
 #include <linux/sched.h>
 
+#include "write-windows.h"
+
 struct mmc_host;
 struct mmc_card;
 struct mmc_request;
--- a/drivers/mmc/core/host.c
+++ b/drivers/mmc/core/host.c
@@ -651,6 +651,15 @@
 	if (err)
 		return err;
 
+	/*
+	 * Read-only guard: no command queue engine (it bypasses the guard in
+	 * __mmc_start_request()); read its write windows, if any.
+	 */
+	if (host->caps2 & MMC_CAP2_FORCE_RO) {
+		host->caps2 &= ~(MMC_CAP2_CQE | MMC_CAP2_CQE_DCMD);
+		mmc_write_windows_setup(host);
+	}
+
 	err = device_add(&host->class_dev);
 	if (err)
 		return err;
--- a/drivers/mmc/core/queue.c
+++ b/drivers/mmc/core/queue.c
@@ -179,6 +179,10 @@
 {
 	unsigned max_discard;
 
+	/* Read-only guard: erase is always refused, announce no discard */
+	if (card->host->caps2 & MMC_CAP2_FORCE_RO)
+		return;
+
 	max_discard = mmc_calc_max_discard(card);
 	if (!max_discard)
 		return;
--- a/drivers/mmc/core/Makefile
+++ b/drivers/mmc/core/Makefile
@@ -10,6 +10,7 @@
 				   sdio_cis.o sdio_io.o sdio_irq.o sd_uhs2.o\
 				   slot-gpio.o regulator.o
 mmc_core-$(CONFIG_OF)		+= pwrseq.o
+mmc_core-$(CONFIG_MMC_WRITE_WINDOWS)	+= write-windows.o
 obj-$(CONFIG_PWRSEQ_SIMPLE)	+= pwrseq_simple.o
 obj-$(CONFIG_PWRSEQ_SD8787)	+= pwrseq_sd8787.o
 obj-$(CONFIG_PWRSEQ_EMMC)	+= pwrseq_emmc.o
