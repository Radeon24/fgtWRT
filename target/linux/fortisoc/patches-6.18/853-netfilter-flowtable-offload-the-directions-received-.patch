From: Evil.2000 <evil.2000@web.de>
Subject: [PATCH] netfilter: flowtable: offload the directions received through xfrm packet offload

A packet a device decrypted through an inbound SA in packet offload,
whose driver keeps the secpath for the kernel to check it against the
forward policy, never sets a flow up: nft_flow_offload_skip() leaves
every packet with a secpath to the slow path.

With NF_FLOW_TABLE_XFRM_OFFLOAD, accept a packet whose secpath holds a
single IPv4 tunnel mode SA in packet offload to the device the packet
came in by, and record that SA in the flow for the direction (held by
the flow). The fast path, which checks such a packet against the
forward policy, records it too: a flow set up by the other direction,
or an SA replaced, is then offered to the driver again.

The hardware offload of a direction with a recorded SA carries a
FLOW_ACTION_XFRM_IN action with the SA: the driver must match only the
packets it decrypted through that SA, never packets received in the
clear or through another SA, and reject the action otherwise. A
direction whose SA is no longer offloaded on its input device stays in
software.

Release what the actions of a rule hold when a later action fails.
---
--- a/include/net/flow_offload.h
+++ b/include/net/flow_offload.h
@@ -185,6 +185,7 @@
 	FLOW_ACTION_VLAN_POP_ETH,
 	FLOW_ACTION_CONTINUE,
 	FLOW_ACTION_XFRM,
+	FLOW_ACTION_XFRM_IN,
 	NUM_FLOW_ACTIONS,
 };
 
@@ -330,7 +331,7 @@
 		struct {				/* FLOW_ACTION_PPPOE_PUSH */
 			u16		sid;
 		} pppoe;
-		struct xfrm_state	*xfrm;		/* FLOW_ACTION_XFRM */
+		struct xfrm_state	*xfrm;		/* FLOW_ACTION_XFRM, _IN */
 	};
 	struct flow_action_cookie *user_cookie; /* user defined action cookie */
 };
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -186,6 +186,10 @@
 	unsigned long				flags;
 	u16					type;
 	u32					timeout;
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	/* inbound SA in packet offload each direction is received through */
+	struct xfrm_state __rcu			*xfrm_in[FLOW_OFFLOAD_DIR_MAX];
+#endif
 	struct rcu_head				rcu_head;
 };
 
@@ -224,6 +228,13 @@
 struct flow_offload *flow_offload_alloc(struct nf_conn *ct);
 void flow_offload_free(struct flow_offload *flow);
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+struct xfrm_state *nf_flow_xfrm_in_state(const struct sk_buff *skb);
+bool nf_flow_xfrm_in_set(struct flow_offload *flow,
+			 enum flow_offload_tuple_dir dir,
+			 struct xfrm_state *x);
+#endif
+
 struct nft_flowtable;
 struct nft_pktinfo;
 int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -7,6 +7,7 @@
 #include <linux/netdevice.h>
 #include <net/ip.h>
 #include <net/ip6_route.h>
+#include <net/xfrm.h>
 #include <net/netfilter/nf_flow_table.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_core.h>
@@ -257,8 +258,73 @@
 	kfree(flow);
 }
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+/* The SA a packet was received through, if it is a single inbound IPv4
+ * tunnel mode SA offloaded in packet mode to the device it came in by: the
+ * device decrypted the packet, so it can tell the packets of this SA from
+ * the others. The caller checked the packet against the forward policy.
+ */
+struct xfrm_state *nf_flow_xfrm_in_state(const struct sk_buff *skb)
+{
+	const struct sec_path *sp = skb_sec_path(skb);
+	struct xfrm_state *x;
+
+	if (!sp || sp->len != 1)
+		return NULL;
+
+	x = sp->xvec[0];
+	if (x->xso.type != XFRM_DEV_OFFLOAD_PACKET ||
+	    x->xso.dir != XFRM_DEV_OFFLOAD_IN ||
+	    READ_ONCE(x->xso.dev) != skb->dev ||
+	    x->props.mode != XFRM_MODE_TUNNEL ||
+	    x->props.family != AF_INET ||
+	    READ_ONCE(x->km.state) != XFRM_STATE_VALID)
+		return NULL;
+
+	return x;
+}
+EXPORT_SYMBOL_GPL(nf_flow_xfrm_in_state);
+
+/* Record the SA a direction is received through, held by the flow. Returns
+ * true if it changed, for the direction to be offered to the driver again.
+ */
+bool nf_flow_xfrm_in_set(struct flow_offload *flow,
+			 enum flow_offload_tuple_dir dir,
+			 struct xfrm_state *x)
+{
+	struct xfrm_state *old;
+
+	if (rcu_access_pointer(flow->xfrm_in[dir]) == x)
+		return false;
+
+	xfrm_state_hold(x);
+	old = unrcu_pointer(xchg(&flow->xfrm_in[dir], RCU_INITIALIZER(x)));
+	if (old)
+		xfrm_state_put(old);
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(nf_flow_xfrm_in_set);
+#endif
+
+static void flow_offload_xfrm_in_release(struct flow_offload *flow)
+{
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	struct xfrm_state *x;
+	int dir;
+
+	/* The SAs are freed after an RCU grace period, as the flow. */
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		x = unrcu_pointer(xchg(&flow->xfrm_in[dir], NULL));
+		if (x)
+			xfrm_state_put(x);
+	}
+#endif
+}
+
 void flow_offload_free(struct flow_offload *flow)
 {
+	flow_offload_xfrm_in_release(flow);
 	switch (flow->type) {
 	case NF_FLOW_OFFLOAD_ROUTE:
 		flow_offload_route_release(flow);
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -436,6 +436,7 @@
 	struct flow_offload *flow;
 	unsigned int thoff, mtu;
 	struct iphdr *iph;
+	bool force = false;
 	int ret;
 
 	dir = tuplehash->tuple.dir;
@@ -459,10 +460,24 @@
 	if (ret <= 0)
 		return ret;
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	/* Decrypted by the device through an SA in packet offload, and
+	 * checked against the forward policy above: the direction may be
+	 * offloaded for the packets of that SA (a flow set up by the other
+	 * direction, or an SA replaced).
+	 */
+	if (secpath_exists(skb)) {
+		struct xfrm_state *x = nf_flow_xfrm_in_state(skb);
+
+		if (x && nf_flow_xfrm_in_set(flow, dir, x))
+			force = true;
+	}
+#endif
+
 	if (skb_try_make_writable(skb, thoff + ctx->hdrsize))
 		return -1;
 
-	flow_offload_refresh(flow_table, flow, false);
+	flow_offload_refresh(flow_table, flow, force);
 
 	nf_flow_encap_pop(skb, tuplehash);
 	thoff -= ctx->offset;
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -726,6 +726,54 @@
 	return 0;
 }
 
+/* The inbound SA the direction is received through (nf_flow_xfrm_in_set()):
+ * the driver must match only the packets it decrypted through that SA, and
+ * reject the action otherwise. A recorded SA no longer offloaded on the
+ * input device keeps the direction in software. The action holds the SA.
+ */
+static int flow_offload_xfrm_in(const struct flow_offload *flow,
+				enum flow_offload_tuple_dir dir,
+				struct nf_flow_rule *flow_rule)
+{
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	const struct flow_offload_tuple *this_tuple = &flow->tuplehash[dir].tuple;
+	struct flow_action_entry *entry;
+	struct net_device *dev;
+	struct xfrm_state *x;
+	int ret = 0;
+
+	rcu_read_lock();
+	x = rcu_dereference(flow->xfrm_in[dir]);
+	if (!x)
+		goto out;
+
+	ret = -EOPNOTSUPP;
+	dev = READ_ONCE(x->xso.dev);
+	if (x->xso.type != XFRM_DEV_OFFLOAD_PACKET ||
+	    x->xso.dir != XFRM_DEV_OFFLOAD_IN ||
+	    !READ_ONCE(x->xso.offload_handle) ||
+	    !dev || dev->ifindex != this_tuple->iifidx ||
+	    READ_ONCE(x->km.state) != XFRM_STATE_VALID ||
+	    !refcount_inc_not_zero(&x->refcnt))
+		goto out;
+
+	entry = flow_action_entry_next(flow_rule);
+	if (!entry) {
+		xfrm_state_put(x);
+		ret = -E2BIG;
+		goto out;
+	}
+	entry->id = FLOW_ACTION_XFRM_IN;
+	entry->xfrm = x;
+	ret = 0;
+out:
+	rcu_read_unlock();
+	return ret;
+#else
+	return 0;
+#endif
+}
+
 static int flow_offload_encap_tunnel(const struct flow_offload *flow,
 				     enum flow_offload_tuple_dir dir,
 				     struct nf_flow_rule *flow_rule)
@@ -873,6 +921,9 @@
 	if (flow_offload_xfrm(flow, dir, flow_rule) < 0)
 		return -1;
 
+	if (flow_offload_xfrm_in(flow, dir, flow_rule) < 0)
+		return -1;
+
 	if (flow_offload_redirect(net, flow, dir, flow_rule) < 0)
 		return -1;
 
@@ -905,6 +956,8 @@
 }
 EXPORT_SYMBOL_GPL(nf_flow_rule_route_ipv6);
 
+static void __nf_flow_offload_destroy(struct nf_flow_rule *flow_rule);
+
 static struct nf_flow_rule *
 nf_flow_offload_rule_alloc(struct net *net,
 			   const struct flow_offload_work *offload,
@@ -939,8 +992,11 @@
 		goto err_flow_match;
 
 	flow_rule->rule->action.num_entries = 0;
-	if (flowtable->type->action(net, flow, dir, flow_rule) < 0)
-		goto err_flow_match;
+	if (flowtable->type->action(net, flow, dir, flow_rule) < 0) {
+		/* release what the actions taken so far hold */
+		__nf_flow_offload_destroy(flow_rule);
+		return NULL;
+	}
 
 	return flow_rule;
 
@@ -959,10 +1015,10 @@
 
 	for (i = 0; i < flow_rule->rule->action.num_entries; i++) {
 		entry = &flow_rule->rule->action.entries[i];
-		if (entry->id != FLOW_ACTION_REDIRECT)
-			continue;
-
-		dev_put(entry->dev);
+		if (entry->id == FLOW_ACTION_REDIRECT)
+			dev_put(entry->dev);
+		else if (entry->id == FLOW_ACTION_XFRM_IN)
+			xfrm_state_put(entry->xfrm);
 	}
 	kfree(flow_rule->rule);
 	kfree(flow_rule);
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -20,9 +20,23 @@
 	struct nft_flowtable	*flowtable;
 };
 
+static struct xfrm_state *nft_flow_offload_xfrm_in(const struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	return nf_flow_xfrm_in_state(skb);
+#else
+	return NULL;
+#endif
+}
+
 static bool nft_flow_offload_skip(struct sk_buff *skb, int family)
 {
-	if (skb_sec_path(skb))
+	/* A packet decrypted by the device it came in by, through an SA in
+	 * packet offload: the flow records the SA (nf_flow_xfrm_in_set()).
+	 */
+	if (skb_sec_path(skb) &&
+	    !(IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD) &&
+	      family == NFPROTO_IPV4 && nft_flow_offload_xfrm_in(skb)))
 		return true;
 
 	if (family == NFPROTO_IPV4) {
@@ -113,6 +127,14 @@
 		goto err_flow_alloc;
 
 	flow_offload_route_init(flow, &route);
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD)
+	if (nft_pf(pkt) == NFPROTO_IPV4) {
+		struct xfrm_state *x = nf_flow_xfrm_in_state(pkt->skb);
+
+		if (x)
+			nf_flow_xfrm_in_set(flow, (enum flow_offload_tuple_dir)dir, x);
+	}
+#endif
 	if (tcph)
 		flow_offload_ct_tcp(ct);
 
