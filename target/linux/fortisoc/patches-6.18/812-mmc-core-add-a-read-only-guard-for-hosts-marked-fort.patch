From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: [PATCH] mmc: core: add a read-only guard for hosts marked fortinet,force-ro

Refuse every write to a card behind a host marked fortinet,force-ro.
Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 drivers/mmc/core/block.c |  1 +
 drivers/mmc/core/core.c  | 88 +++++++++++++++++++++++++++++++++++++++++
 drivers/mmc/core/host.c  |  2 +
 drivers/mmc/core/mmc.c   |  4 ++
 include/linux/mmc/host.h |  1 +
 5 files changed, 96 insertions(+)

--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -2490,6 +2490,7 @@ enum mmc_issued mmc_blk_mq_issue_rq(stru
 static inline int mmc_blk_readonly(struct mmc_card *card)
 {
 	return mmc_card_readonly(card) ||
+	       (card->host->caps2 & MMC_CAP2_FORCE_RO) ||
 	       !(card->csd.cmdclass & CCC_BLOCK_WRITE);
 }
 
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -212,10 +212,98 @@ void mmc_request_done(struct mmc_host *h
 
 EXPORT_SYMBOL(mmc_request_done);
 
+/*
+ * Read-only guard (MMC_CAP2_FORCE_RO, "fortinet,force-ro"): only the commands
+ * needed to bring up an (e)MMC card and to read its user area reach the host.
+ * CMD6 SWITCH may only write the bus width (SDR) and HS_TIMING (legacy or high
+ * speed), two EXT_CSD fields that the card resets at power-up; every other
+ * EXT_CSD field (PARTITION_CONFIG, BKOPS_EN, CACHE_CTRL, ERASE_GROUP_DEF...),
+ * every data write, erase, write protection, lock, CID/CSD programming and
+ * SDIO/SD command is refused here, for every user of the host (block layer,
+ * ioctl, core).
+ */
+static bool mmc_force_ro_cmd_ok(const struct mmc_command *cmd)
+{
+	u32 arg = cmd->arg;
+
+	switch (cmd->opcode) {
+	case MMC_GO_IDLE_STATE:
+		return arg == 0;	/* no pre-idle, no boot operation */
+	case MMC_SEND_OP_COND:
+	case MMC_ALL_SEND_CID:
+	case MMC_SET_RELATIVE_ADDR:
+	case MMC_SELECT_CARD:
+	case MMC_SEND_EXT_CSD:
+	case MMC_SEND_CSD:
+	case MMC_SEND_CID:
+	case MMC_STOP_TRANSMISSION:
+	case MMC_SEND_STATUS:
+	case MMC_SET_BLOCKLEN:
+	case MMC_READ_SINGLE_BLOCK:
+	case MMC_READ_MULTIPLE_BLOCK:
+		return true;
+	case MMC_SET_BLOCK_COUNT:
+		/* block count only: no reliable write, packed, tag or forced programming */
+		return !(arg & 0xffff0000);
+	case MMC_SWITCH: {
+		u8 access = (arg >> 24) & 0x3;
+		u8 index = (arg >> 16) & 0xff;
+		u8 value = (arg >> 8) & 0xff;
+
+		if (access != MMC_SWITCH_MODE_WRITE_BYTE)
+			return false;
+		if (index == EXT_CSD_BUS_WIDTH)
+			return value <= EXT_CSD_BUS_WIDTH_8;	/* SDR 1/4/8, no DDR/strobe */
+		if (index == EXT_CSD_HS_TIMING)
+			return value <= EXT_CSD_TIMING_HS;	/* no HS200/HS400 */
+		return false;
+	}
+	default:
+		return false;
+	}
+}
+
+static int mmc_force_ro_check(struct mmc_host *host, struct mmc_request *mrq)
+{
+	struct mmc_command *bad = NULL;
+
+	if (mrq->data && (mrq->data->flags & MMC_DATA_WRITE))
+		bad = mrq->cmd;
+	else if (mrq->sbc && !mmc_force_ro_cmd_ok(mrq->sbc))
+		bad = mrq->sbc;
+	else if (mrq->stop && mrq->stop->opcode != MMC_STOP_TRANSMISSION)
+		bad = mrq->stop;
+	else if (!mmc_force_ro_cmd_ok(mrq->cmd))
+		bad = mrq->cmd;
+	if (!bad)
+		return 0;
+
+	pr_warn_ratelimited("%s: force-ro: CMD%u arg %#010x refused\n",
+			    mmc_hostname(host), bad->opcode, bad->arg);
+	/*
+	 * A refused CMD6 answers -EBADMSG, the error that mmc_init_card()
+	 * tolerates for the optional EXT_CSD features (ERASE_GROUP_DEF,
+	 * PARTITION_CONFIG, POWER_OFF_NOTIFICATION, HPI_MGMT, CACHE_CTRL).
+	 */
+	return mrq->cmd->opcode == MMC_SWITCH && !mrq->data ? -EBADMSG : -EROFS;
+}
+
 static void __mmc_start_request(struct mmc_host *host, struct mmc_request *mrq)
 {
 	int err;
 
+	if (unlikely(host->caps2 & MMC_CAP2_FORCE_RO)) {
+		err = mmc_force_ro_check(host, mrq);
+		if (err) {
+			mrq->cmd->error = err;
+			mrq->cmd->retries = 0;
+			if (mrq->data)
+				mrq->data->error = err;
+			mmc_request_done(host, mrq);
+			return;
+		}
+	}
+
 	/* Assumes host controller has been runtime resumed by mmc_claim_host */
 	err = mmc_retune(host);
 	if (err) {
--- a/drivers/mmc/core/host.c
+++ b/drivers/mmc/core/host.c
@@ -400,6 +400,8 @@ int mmc_of_parse(struct mmc_host *host)
 		host->caps2 |= MMC_CAP2_HS400_ES;
 	if (device_property_read_bool(dev, "no-sdio"))
 		host->caps2 |= MMC_CAP2_NO_SDIO;
+	if (device_property_read_bool(dev, "fortinet,force-ro"))
+		host->caps2 |= MMC_CAP2_FORCE_RO;
 	if (device_property_read_bool(dev, "no-sd"))
 		host->caps2 |= MMC_CAP2_NO_SD;
 	if (device_property_read_bool(dev, "no-mmc"))
--- a/drivers/mmc/core/mmc.c
+++ b/drivers/mmc/core/mmc.c
@@ -319,6 +319,10 @@ static void mmc_part_add(struct mmc_card
 			 unsigned int part_cfg, char *name, int idx, bool ro,
 			 int area_type)
 {
+	/* Read-only host: user area only (no boot, GP or RPMB partition) */
+	if (card->host->caps2 & MMC_CAP2_FORCE_RO)
+		return;
+
 	card->part[card->nr_parts].size = size;
 	card->part[card->nr_parts].part_cfg = part_cfg;
 	sprintf(card->part[card->nr_parts].name, name, idx);
--- a/include/linux/mmc/host.h
+++ b/include/linux/mmc/host.h
@@ -440,6 +440,7 @@ struct mmc_host {
 #define MMC_CAP2_SD_UHS2	(1 << 9)	/* SD UHS-II support */
 #define MMC_CAP2_CD_ACTIVE_HIGH	(1 << 10)	/* Card-detect signal active high */
 #define MMC_CAP2_RO_ACTIVE_HIGH	(1 << 11)	/* Write-protect signal active high */
+#define MMC_CAP2_FORCE_RO	(1 << 12)	/* Never write: read commands only */
 #define MMC_CAP2_NO_PRESCAN_POWERUP (1 << 14)	/* Don't power up before scan */
 #define MMC_CAP2_HS400_1_8V	(1 << 15)	/* Can support HS400 1.8V */
 #define MMC_CAP2_HS400_1_2V	(1 << 16)	/* Can support HS400 1.2V */
