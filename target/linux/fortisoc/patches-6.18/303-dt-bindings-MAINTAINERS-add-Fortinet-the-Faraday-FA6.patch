+F:	Documentation/devicetree/bindings/i2c/fortinet,fsoc3-i2c.yaml
+F:	Documentation/devicetree/bindings/misc/fortinet,disk-rootfs-data.yaml
+F:	Documentation/devicetree/bindings/misc/fortinet,usb-disk-write-windows.yaml
+F:	Documentation/devicetree/bindings/mmc/fortinet,fsoc3-sdhi.yaml
+F:	Documentation/devicetree/bindings/net/fortinet,fsoc1-np.yaml
+F:	Documentation/devicetree/bindings/net/fortinet,fsoc3-np6lite.yaml
+F:	Documentation/devicetree/bindings/nvmem/fortinet,fsoc3-boot-flash.yaml
+F:	Documentation/devicetree/bindings/power/reset/fortinet,fsoc3-reboot.yaml
+F:	Documentation/devicetree/bindings/rtc/fortinet,fsoc*-rtc.yaml
+F:	Documentation/devicetree/bindings/soc/fortinet/
+F:	Documentation/devicetree/bindings/spi/fortinet,fsoc2-ssp.yaml
+F:	arch/arm/boot/dts/fortinet/
