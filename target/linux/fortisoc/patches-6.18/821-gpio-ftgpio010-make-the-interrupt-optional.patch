From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: [PATCH] gpio: ftgpio010: make the interrupt optional

Make the interrupt of the FTGPIO010 optional, in the binding and in the
driver.
Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 ...devicetree/bindings/gpio/faraday,ftgpio010.yaml | 12 ++-
 drivers/gpio/gpio-ftgpio010.c                      | 59 ++++++++-------
 2 files changed, 41 insertions(+), 30 deletions(-)

--- a/Documentation/devicetree/bindings/gpio/faraday,ftgpio010.yaml
+++ b/Documentation/devicetree/bindings/gpio/faraday,ftgpio010.yaml
@@ -31,12 +31,16 @@ properties:
 
   interrupts:
     maxItems: 1
-    description: Should contain the interrupt line for the GPIO block
+    description: The interrupt line of the GPIO block. Optional, for
+      integrations where it is not wired or not known; the block then
+      provides no interrupts.
 
   gpio-controller: true
   "#gpio-cells":
     const: 2
 
+  gpio-reserved-ranges: true
+
   interrupt-controller: true
   "#interrupt-cells":
     const: 2
@@ -44,10 +48,10 @@ properties:
 required:
   - compatible
   - reg
-  - interrupts
   - "#gpio-cells"
-  - interrupt-controller
-  - "#interrupt-cells"
+
+dependencies:
+  interrupt-controller: [ interrupts, "#interrupt-cells" ]
 
 additionalProperties: false
 
--- a/drivers/gpio/gpio-ftgpio010.c
+++ b/drivers/gpio/gpio-ftgpio010.c
@@ -252,8 +252,9 @@ static int ftgpio_gpio_probe(struct plat
 	if (IS_ERR(g->base))
 		return PTR_ERR(g->base);
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
+	/* The interrupt is optional: without it, the block is a plain gpiochip */
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq < 0 && irq != -ENXIO)
 		return irq;
 
 	g->clk = devm_clk_get_enabled(dev, NULL);
@@ -283,30 +284,36 @@ static int ftgpio_gpio_probe(struct plat
 	g->chip.gc.owner = THIS_MODULE;
 	/* ngpio is set by gpio_generic_chip_init() */
 
-	/* We need a silicon clock to do debounce */
-	if (!IS_ERR(g->clk))
-		g->chip.gc.set_config = ftgpio_gpio_set_config;
-
-	girq = &g->chip.gc.irq;
-	gpio_irq_chip_set_chip(girq, &ftgpio_irq_chip);
-	girq->parent_handler = ftgpio_gpio_irq_handler;
-	girq->num_parents = 1;
-	girq->parents = devm_kcalloc(dev, 1, sizeof(*girq->parents),
-				     GFP_KERNEL);
-	if (!girq->parents)
-		return -ENOMEM;
-
-	girq->default_type = IRQ_TYPE_NONE;
-	girq->handler = handle_bad_irq;
-	girq->parents[0] = irq;
-
-	/* Disable, unmask and clear all interrupts */
-	writel(0x0, g->base + GPIO_INT_EN);
-	writel(0x0, g->base + GPIO_INT_MASK);
-	writel(~0x0, g->base + GPIO_INT_CLR);
-
-	/* Clear any use of debounce */
-	writel(0x0, g->base + GPIO_DEBOUNCE_EN);
+	/*
+	 * Without the interrupt, leave the interrupt and debounce registers
+	 * alone: debouncing only works on interrupt-enabled lines.
+	 */
+	if (irq > 0) {
+		/* We need a silicon clock to do debounce */
+		if (!IS_ERR(g->clk))
+			g->chip.gc.set_config = ftgpio_gpio_set_config;
+
+		girq = &g->chip.gc.irq;
+		gpio_irq_chip_set_chip(girq, &ftgpio_irq_chip);
+		girq->parent_handler = ftgpio_gpio_irq_handler;
+		girq->num_parents = 1;
+		girq->parents = devm_kcalloc(dev, 1, sizeof(*girq->parents),
+					     GFP_KERNEL);
+		if (!girq->parents)
+			return -ENOMEM;
+
+		girq->default_type = IRQ_TYPE_NONE;
+		girq->handler = handle_bad_irq;
+		girq->parents[0] = irq;
+
+		/* Disable, unmask and clear all interrupts */
+		writel(0x0, g->base + GPIO_INT_EN);
+		writel(0x0, g->base + GPIO_INT_MASK);
+		writel(~0x0, g->base + GPIO_INT_CLR);
+
+		/* Clear any use of debounce */
+		writel(0x0, g->base + GPIO_DEBOUNCE_EN);
+	}
 
 	return devm_gpiochip_add_data(dev, &g->chip.gc, g);
 }
