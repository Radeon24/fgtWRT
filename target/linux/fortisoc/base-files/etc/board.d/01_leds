. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
fortinet,fg60d)
	# STATUS is driven by diag.sh through the led-* aliases of the device
	# tree; HA is left off.
	# The speed LED of each WAN port is one bicolour LED between two pins
	# of its BCM54612E PHY: green is offloaded to the PHY at 1000 Mbit/s,
	# orange is driven in software at 100 Mbit/s (off at 1000, which leaves
	# the green pin alone). The second LED shows the link and blinks on
	# activity, offloaded to the PHY, so that it also sees the traffic
	# forwarded by the network processor. The trigger is offloaded once
	# the PHY is attached, when the port is brought up.
	# PHY addresses (hexadecimal in the LED names): wan1 18, wan2 19
	for p in 1:18 2:19; do
		port=${p%:*}
		phy="e3f00000.ethernet-mii:${p#*:}"
		ucidef_set_led_netdev "wan${port}_1000" "WAN${port} 1000" \
			"$phy:green:speed-wan" "wan$port" "link_1000"
		ucidef_set_led_netdev "wan${port}_100" "WAN${port} 100" \
			"$phy:orange:speed-wan" "wan$port" "link_100"
		ucidef_set_led_netdev "wan${port}" "WAN${port}" \
			"$phy:green:wan" "wan$port" "link tx rx"
	done
	;;
esac

board_config_flush

exit 0
