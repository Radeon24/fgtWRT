. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
fortinet,fg60c)
	# The second bicolour LED of the front panel (ALARM or HA, not
	# established): listed for the LED configuration, off and
	# without a trigger.
	ucidef_set_led_default "alarm_green" "ALARM green" "alarm:green" "0"
	ucidef_set_led_default "alarm_red" "ALARM red" "alarm:red" "0"
	;;
fortinet,fg60d)
	# STATUS is driven by diag.sh through the led-* aliases of the device
	# tree. HA is listed for the LED configuration, off and without a
	# trigger; the ALARM LED has no known GPIO line.
	ucidef_set_led_default "ha_green" "HA green" "green:ha" "0"
	ucidef_set_led_default "ha_orange" "HA orange" "orange:ha" "0"
	# The speed LED of each WAN port is one bicolour LED between two pins
	# of its BCM54612E PHY: green is offloaded to the PHY at 1000 Mbit/s,
	# orange is driven in software at 100 Mbit/s (off at 1000, which leaves
	# the green pin alone). The second LED shows the link and blinks on
	# activity, offloaded to the PHY, so that it also sees the traffic
	# forwarded by the network processor. The trigger is offloaded once
	# the PHY is attached, when the port is brought up.
	# PHY addresses (hexadecimal in the LED names): wan1 18, wan2 19
	for p in 1:18 2:19; do
		port=${p%:*}
		phy="e3f00000.ethernet-mii:${p#*:}"
		ucidef_set_led_netdev "wan${port}_1000" "WAN${port} 1000" \
			"$phy:green:speed-wan" "wan$port" "link_1000"
		ucidef_set_led_netdev "wan${port}_100" "WAN${port} 100" \
			"$phy:orange:speed-wan" "wan$port" "link_100"
		ucidef_set_led_netdev "wan${port}" "WAN${port}" \
			"$phy:green:wan" "wan$port" "link tx rx"
	done
	;;
fortinet,fg60e)
	# STATUS is driven by diag.sh through the led-* aliases of the device
	# tree (green blinking while booting, green once running, orange
	# blinking in failsafe and during an upgrade). HA is listed for the
	# LED configuration, off and without a trigger; no ALARM LED.
	ucidef_set_led_default "ha_green" "HA green" "green:ha" "0"
	ucidef_set_led_default "ha_orange" "HA orange" "orange:ha" "0"
	# The speed LED of each WAN port is one bicolour LED between the
	# LED[0] pin of its 88E1514 PHY and an output line of the system
	# manager: green is offloaded to the PHY at 1000 Mbit/s, orange is
	# that line driven low in software at 100 Mbit/s (off at 1000, which
	# leaves the green half alone). The second LED shows the link and
	# blinks on activity, offloaded to the PHY, so that it also sees the
	# traffic forwarded by the network processor. The trigger is
	# offloaded once the PHY is attached, when the port is brought up.
	# PHY addresses: wan1 0, wan2 1
	for port in 1 2; do
		phy="f5000000.ethernet-mii0:0$((port - 1))"
		ucidef_set_led_netdev "wan${port}_1000" "WAN${port} 1000" \
			"$phy:green:speed-wan" "wan$port" "link_1000"
		ucidef_set_led_netdev "wan${port}_100" "WAN${port} 100" \
			"orange:speed-wan-$port" "wan$port" "link_100"
		ucidef_set_led_netdev "wan${port}" "WAN${port}" \
			"$phy:green:wan" "wan$port" "link tx rx"
	done
	;;
fortinet,fg100e)
	# STATUS is driven by diag.sh through the led-* aliases of the device
	# tree (green blinking while booting, green once running, red
	# blinking in failsafe and during an upgrade). On a kernel panic ALARM
	# red blinks and STATUS goes dark (panic-indicator). HA and ALARM
	# orange are listed for the LED configuration, off and without a
	# trigger.
	ucidef_set_led_default "ha_green" "HA green" "green:ha" "0"
	ucidef_set_led_default "ha_red" "HA red" "red:ha" "0"
	ucidef_set_led_default "alarm_orange" "ALARM orange" "orange:alarm" "0"
	;;
esac

board_config_flush

exit 0
