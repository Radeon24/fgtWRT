From: Radeon24 <Radeon24@users.noreply.github.com>
Subject: device: add a bpdu_filter option for bridge ports

The BPDU filter of a bridge port (brport/bpdu_filter, OpenWrt kernel
patch "bridge: add knob for filtering rx/tx BPDU packets on a port") is
only set by netifd for wireless AP interfaces. Accept it as a device
option too, so that a wired bridge member can be configured with it:

  config device
  	option name 'port1'
  	option bpdu_filter '1'

It is written right after the port joins the bridge, in the same place
as for wireless AP interfaces.

--- a/device.h
+++ b/device.h
@@ -82,6 +82,7 @@
 	DEV_ATTR_PSE_PODL,
 	DEV_ATTR_PSE_POWER_LIMIT,
 	DEV_ATTR_PSE_PRIORITY,
+	DEV_ATTR_BPDU_FILTER,
 
 	/* No DEV_OPT_* counterpart; carry data consumed outside flags. */
 	DEV_ATTR_TYPE,
@@ -176,6 +177,7 @@
 	DEV_OPT_PSE_PODL			= 1ULL << DEV_ATTR_PSE_PODL,
 	DEV_OPT_PSE_POWER_LIMIT			= 1ULL << DEV_ATTR_PSE_POWER_LIMIT,
 	DEV_OPT_PSE_PRIORITY			= 1ULL << DEV_ATTR_PSE_PRIORITY,
+	DEV_OPT_BPDU_FILTER			= 1ULL << DEV_ATTR_BPDU_FILTER,
 
 	DEV_OPT_DEFAULT_MACADDR			= 1ULL << 63,
 };
@@ -254,6 +256,7 @@
 	bool sendredirects;
 	bool ip6segmentrouting;
 	bool isolate;
+	bool bpdu_filter;
 	bool drop_v4_unicast_in_l2_multicast;
 	bool drop_v6_unicast_in_l2_multicast;
 	bool drop_gratuitous_arp;
--- a/device.c
+++ b/device.c
@@ -58,6 +58,7 @@
 	[DEV_ATTR_SENDREDIRECTS] = { .name = "sendredirects", .type = BLOBMSG_TYPE_BOOL },
 	[DEV_ATTR_NEIGHLOCKTIME] = { .name = "neighlocktime", .type = BLOBMSG_TYPE_INT32 },
 	[DEV_ATTR_ISOLATE] = { .name = "isolate", .type = BLOBMSG_TYPE_BOOL },
+	[DEV_ATTR_BPDU_FILTER] = { .name = "bpdu_filter", .type = BLOBMSG_TYPE_BOOL },
 	[DEV_ATTR_DROP_V4_UNICAST_IN_L2_MULTICAST] = { .name = "drop_v4_unicast_in_l2_multicast", .type = BLOBMSG_TYPE_BOOL },
 	[DEV_ATTR_DROP_V6_UNICAST_IN_L2_MULTICAST] = { .name = "drop_v6_unicast_in_l2_multicast", .type = BLOBMSG_TYPE_BOOL },
 	[DEV_ATTR_DROP_GRATUITOUS_ARP] = { .name = "drop_gratuitous_arp", .type = BLOBMSG_TYPE_BOOL },
@@ -532,6 +533,11 @@
 		s->flags |= DEV_OPT_ISOLATE;
 	}
 
+	if ((cur = tb[DEV_ATTR_BPDU_FILTER])) {
+		s->bpdu_filter = blobmsg_get_bool(cur);
+		s->flags |= DEV_OPT_BPDU_FILTER;
+	}
+
 	if ((cur = tb[DEV_ATTR_DROP_V4_UNICAST_IN_L2_MULTICAST])) {
 		s->drop_v4_unicast_in_l2_multicast = blobmsg_get_bool(cur);
 		s->flags |= DEV_OPT_DROP_V4_UNICAST_IN_L2_MULTICAST;
--- a/system-linux.c
+++ b/system-linux.c
@@ -1040,8 +1040,9 @@
 	    dev->settings.isolate)
 		system_bridge_set_isolated(dev, "1");
 
-	if (dev->bpdu_filter)
-		system_bridge_set_bpdu_filter(dev, dev->bpdu_filter ? "1" : "0");
+	if (dev->bpdu_filter ||
+	    (dev->settings.flags & DEV_OPT_BPDU_FILTER && dev->settings.bpdu_filter))
+		system_bridge_set_bpdu_filter(dev, "1");
 
 	return ret;
 }
