From cdb248ed2447ccfad6bbdf5f08e7fab4779e8952 Mon Sep 17 00:00:00 2001
From: Radeon24 <Radeon24@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:03:13 +0200
Subject: [PATCH 103/103] factoryreset: mark a mounted fortisoc overlay
 pending, erase at next boot

On a "fortisoc" volume, rootfs_data is an ext4 filesystem on a loop
device, mounted as the upper layer of the overlay the system runs on.
firstboot (factoryreset -y) erased its files there and remounted the
root: this changes a layer under a mounted overlayfs, which overlayfs
leaves undefined. On an x86-64 board, the next command failed with
ESTALE ("Error loading shared library libgcc_s.so.1: Stale file
handle") and neither sync nor reboot ran; only a power cut recovered.

For this driver, leave the files alone: set .fs_state to pending in the
mount point (outside the layers), remove sysupgrade.tgz unless -k, and
sync. mount_overlay() then erases the files at the next boot, before
the overlay is set up, as it already does for a pending state. No raw
write to the mounted loop device (refused without
CONFIG_BLK_DEV_WRITE_MOUNTED), no format, and a power cut before the
reboot still erases. Failing to set the state fails the command with
nothing erased. Other drivers keep the upstream behaviour.

Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 factoryreset.c | 44 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

diff --git a/factoryreset.c b/factoryreset.c
index 0985b3a..1d9cdfc 100644
--- a/factoryreset.c
+++ b/factoryreset.c
@@ -17,6 +17,7 @@
 #include <sys/reboot.h>
 #include <libubox/ulog.h>
 
+#include <errno.h>
 #include <fcntl.h>
 #include <dirent.h>
 #include <stdint.h>
@@ -43,12 +44,53 @@ ask_user(void)
 	return 0;
 }
 
+/*
+ * The "fortisoc" volume is an ext4 filesystem on a loop device: once
+ * mounted, it holds the upper layer of the overlay the system runs on.
+ * Erasing its files there changes a layer under a mounted overlayfs,
+ * which overlayfs leaves undefined: open(2) of paths of the running
+ * system can fail with ESTALE, and neither sync nor reboot may run
+ * again. Leave the files alone and mark the filesystem pending:
+ * mount_overlay() erases them at the next boot, before the overlay is
+ * set up, keeping sysupgrade.tgz, which is removed now unless asked to
+ * keep it. The mark lives in the filesystem itself (.fs_state), outside
+ * the layers: no raw write to the loop device, no format, and a power
+ * cut before the reboot still erases.
+ */
+static int fortisoc_reset_pending(struct volume *v, const char *mp, int keep)
+{
+	char path[256];
+
+	ULOG_INFO("%s is mounted as %s, its files will be erased at the next boot\n",
+		  v->blk, mp);
+
+	fs_state_set(mp, FS_STATE_PENDING);
+	if (fs_state_get(mp) != FS_STATE_PENDING) {
+		ULOG_ERR("cannot mark %s as pending: %m\n", mp);
+		return -1;
+	}
+
+	if (!keep) {
+		snprintf(path, sizeof(path), "%s/sysupgrade.tgz", mp);
+		if (unlink(path) && errno != ENOENT) {
+			ULOG_ERR("cannot remove %s: %m\n", path);
+			return -1;
+		}
+	}
+
+	sync();
+	return 0;
+}
+
 static int jffs2_reset(struct volume *v, int reset, int keep)
 {
 	char *mp;
 
 	mp = find_mount_point(v->blk, 1);
-	if (mp) {
+	if (mp && v->drv->name && !strcmp(v->drv->name, "fortisoc")) {
+		if (fortisoc_reset_pending(v, mp, keep))
+			return -1;
+	} else if (mp) {
 		ULOG_INFO("%s is mounted as %s, only erasing files\n", v->blk, mp);
 		fs_state_set("/overlay", FS_STATE_PENDING);
 		overlay_delete(mp, keep);
-- 
