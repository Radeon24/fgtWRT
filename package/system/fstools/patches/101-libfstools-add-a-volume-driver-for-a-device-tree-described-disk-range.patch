From 64bd1a465c926ed9346a289bdddacca8da90e807 Mon Sep 17 00:00:00 2001
From: Radeon24 <Radeon24@users.noreply.github.com>
Date: Wed, 14 Oct 2026 11:40:29 +0200
Subject: [PATCH 101/101] libfstools: add a volume driver for a device tree
 described disk range

Some boards keep their root filesystem in an initramfs and have a plain
disk whose layout the boot loader imposes: no squashfs at the start of a
partition (rootdisk) and no partition table to name the overlay
(partname).

Add the "fortisoc" volume driver. It reads a node, direct child of the
device tree root, of compatible "fortinet,disk-rootfs-data":

	rootfs-data {
		compatible = "fortinet,disk-rootfs-data";
		fortinet,disk-vendor = "...";		(optional)
		fortinet,disk-model = "...";		(optional)
		fortinet,disk-sectors = /bits/ 64 <N>;
		fortinet,rootfs-data = <start count>;
	};

Sectors are 512 bytes, absolute on the disk. The disk is the only whole
block device of N sectors whose vendor and model match when given. A
missing required property, or any property present but malformed (an
over-long or unterminated vendor or model string included), gives no
volume and is logged as such: it never reads as an absent one. The
rootfs_data volume is the range start..start+count-1, exposed through a
loop device bounded to it (offset and size limit, autoclear). The loop
device is backed by the whole disk and switched to direct I/O: sync(2)
can otherwise leave its writes dirty in the page cache of the disk until
writeback. If direct I/O is refused, the loop stays buffered and the
page cache of the disk writes back whole 4 KiB pages: start and count
must be multiples of 8 sectors, or writes would spill out of the range.

The status of the existing loop devices is read through read-only
descriptors: a loop device holding a mounted filesystem refuses to open
for writing when the kernel is built without
CONFIG_BLK_DEV_WRITE_MOUNTED. The loop device already bound to the range
(the mounted overlay, for firstboot or factoryreset) is reused; only a
free one is opened read-write to be bound. A loop device whose status
cannot be read, that maps part of the range, or a second binding of the
range makes the driver fail instead of binding another loop device to
the same sectors. A disk path that does not fit in lo_file_name is
refused rather than truncated.

The kernel of these boards guards the disk and only lets writes through
its windows; the range must be the one persistent window its witness
(/sys/module/block/parameters/write_windows) shows, in a state where
that window is open (disarmed, armed or expired). Without the witness,
or with another window, there is no volume.

The range is only claimed when it already holds an ext4 filesystem
labelled rootfs_data, an erase marker or a configuration backup; f2fs
is not claimed, the overlay is ext4 there. A blank or unknown range is
left alone, so nothing is ever written to a disk that was not prepared
for an overlay; on the described disk, it is logged as an error (an
interrupted first format leaves the range so) and not formatted again
automatically. Without a volume, mount_root mounts no overlay at all
(volume_identify() of no volume fails): the root stays the initramfs.
A disk whose /dev node cannot be opened yet (its sysfs entry may come
first) gives no volume either, with the open error in the log.

Outside preinit (PREINIT unset, no /tmp/.preinit), the range is only
claimed while a loop device bound to it is mounted: a disk that shows
up after preinit is never formatted nor switched to by "mount_root
done" under a running system. When preinit left /tmp/.fortisoc_disk_late
(the disk did not show up in time), that case is logged as an error.

The device tree, sysfs, /dev, witness, mounts and flag paths can be
overridden at build time for host testing.

Assisted-by: LLM
Signed-off-by: Radeon24 <Radeon24@users.noreply.github.com>
---
 CMakeLists.txt        |   1 +
 libfstools/fortisoc.c | 893 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 894 insertions(+)
 create mode 100644 libfstools/fortisoc.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e138f98..932f6e2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,6 +16,7 @@ ADD_LIBRARY(fstools SHARED
 		libfstools/mount.c
 		libfstools/ubi.c
 		libfstools/rootdisk.c
+		libfstools/fortisoc.c
 		libfstools/partname.c
 		libfstools/find.c)
 TARGET_LINK_LIBRARIES(fstools ubox)
diff --git a/libfstools/fortisoc.c b/libfstools/fortisoc.c
new file mode 100644
index 0000000..05786a1
--- /dev/null
+++ b/libfstools/fortisoc.c
@@ -0,0 +1,893 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Overlay volume described by the device tree as a range of a whole disk.
+ *
+ * The board device tree carries a node, direct child of the root:
+ *
+ *	rootfs-data {
+ *		compatible = "fortinet,disk-rootfs-data";
+ *		fortinet,disk-vendor = "...";		(optional)
+ *		fortinet,disk-model = "...";		(optional)
+ *		fortinet,disk-sectors = /bits/ 64 <N>;
+ *		fortinet,rootfs-data = <start count>;
+ *	};
+ *
+ * All sector values are 512-byte sectors, absolute on the disk. The disk is
+ * the only whole block device whose size is N sectors and whose vendor and
+ * model strings match, when given. The range is exposed through a loop
+ * device bounded to it, backed by the whole disk and switched to direct
+ * I/O, so that a completed write is on the disk, not in its page cache.
+ * If direct I/O is refused, the loop stays buffered and the page cache of
+ * the disk writes back whole 4 KiB pages: start and count must be multiples
+ * of 8 sectors, or a write would spill out of the range.
+ *
+ * The kernel guards that disk: the range must be its one persistent write
+ * window, as the witness of the guard shows it (state "disarmed", "armed"
+ * or "expired", then "persistent start+count"); otherwise no volume.
+ *
+ * A range whose content is not recognised (no ext4 filesystem labelled
+ * rootfs_data, no erase marker, no configuration backup) is never claimed,
+ * so nothing is ever written to a disk that was not prepared for an
+ * overlay. f2fs is not claimed either: the overlay is ext4 there. Such a
+ * range on the described disk is reported as an error: an interrupted
+ * first format leaves it so, and it is not formatted again automatically.
+ *
+ * Outside preinit, the range is claimed only while it is mounted: a disk
+ * that shows up after preinit is never formatted or switched to under a
+ * running system ("mount_root done").
+ */
+
+#include "common.h"
+
+#include <errno.h>
+#include <linux/loop.h>
+
+#ifndef FORTISOC_DT_BASE
+#define FORTISOC_DT_BASE	"/sys/firmware/devicetree/base"
+#endif
+#ifndef FORTISOC_SYS_BLOCK
+#define FORTISOC_SYS_BLOCK	"/sys/block"
+#endif
+#ifndef FORTISOC_DEV_DIR
+#define FORTISOC_DEV_DIR	"/dev"
+#endif
+#ifndef FORTISOC_WRITE_WINDOWS
+#define FORTISOC_WRITE_WINDOWS	"/sys/module/block/parameters/write_windows"
+#endif
+#ifndef FORTISOC_PROC_MOUNTS
+#define FORTISOC_PROC_MOUNTS	"/proc/self/mounts"
+#endif
+#ifndef FORTISOC_PREINIT_FLAG
+#define FORTISOC_PREINIT_FLAG	"/tmp/.preinit"
+#endif
+/* left by preinit when the disk did not show up in time */
+#ifndef FORTISOC_LATE_FLAG
+#define FORTISOC_LATE_FLAG	"/tmp/.fortisoc_disk_late"
+#endif
+
+#define FORTISOC_COMPATIBLE	"fortinet,disk-rootfs-data"
+#define FORTISOC_PATHLEN	256
+#define FORTISOC_STRLEN		64
+/* sectors per page of the page cache of the disk (4 KiB) */
+#define FORTISOC_ALIGN		8
+/* ext4 superblock (at 1 KiB): s_volume_name, 16 bytes */
+#define FORTISOC_EXT4_LABEL	(0x400 + 0x78)
+#define FORTISOC_LABEL		"rootfs_data"
+#define FORTISOC_LOOPS		8
+
+struct fortisoc_volume {
+	struct volume v;
+	uint64_t offset;
+	uint64_t size;
+	char disk[FORTISOC_PATHLEN];
+	char loop_name[FORTISOC_PATHLEN];
+};
+
+struct fortisoc_desc {
+	char vendor[FORTISOC_STRLEN + 1];
+	char model[FORTISOC_STRLEN + 1];
+	uint64_t disk_sectors;
+	uint64_t start;
+	uint64_t count;
+};
+
+static struct driver fortisoc_driver;
+
+/* Read at most len bytes of a file; returns the length read or -1. */
+static ssize_t fortisoc_read_file(const char *dir, const char *name,
+				  void *buf, size_t len)
+{
+	char path[FORTISOC_PATHLEN];
+	ssize_t n;
+	int fd;
+
+	if (snprintf(path, sizeof(path), "%s/%s", dir, name) >= (int)sizeof(path)) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return -1;
+
+	n = read(fd, buf, len);
+	close(fd);
+	if (n < 0 && errno == ENOENT)
+		errno = EIO;
+
+	return n;
+}
+
+static void fortisoc_trim(char *s)
+{
+	size_t l = strlen(s);
+
+	while (l > 0 && (s[l - 1] == ' ' || s[l - 1] == '\t' || s[l - 1] == '\n'))
+		s[--l] = '\0';
+}
+
+/*
+ * Device tree properties: 0 if read, 1 if absent (ENOENT), -1 if present
+ * but invalid. An invalid property must never read as an absent one.
+ */
+
+/* Non-empty string, NUL terminated, at most FORTISOC_STRLEN bytes. */
+static int fortisoc_dt_string(const char *node, const char *prop, char *buf)
+{
+	ssize_t n;
+
+	n = fortisoc_read_file(node, prop, buf, FORTISOC_STRLEN + 1);
+	if (n < 0 && errno == ENOENT)
+		return 1;
+	if (n < 2 || n > FORTISOC_STRLEN || buf[n - 1] != '\0' ||
+	    strlen(buf) != (size_t)n - 1)
+		return -1;
+
+	fortisoc_trim(buf);
+	return buf[0] ? 0 : -1;
+}
+
+/* Property of exactly len bytes. */
+static int fortisoc_dt_fixed(const char *node, const char *prop, void *buf,
+			     size_t len)
+{
+	char tmp[16];
+	ssize_t n;
+
+	if (len > sizeof(tmp) - 1)
+		return -1;
+
+	n = fortisoc_read_file(node, prop, tmp, sizeof(tmp));
+	if (n < 0 && errno == ENOENT)
+		return 1;
+	if (n != (ssize_t)len)
+		return -1;
+
+	memcpy(buf, tmp, len);
+	return 0;
+}
+
+static int fortisoc_dt_check(const char *node, const char *prop, int ret)
+{
+	if (ret > 0)
+		ULOG_ERR("%s: missing property %s: no overlay\n", node, prop);
+	else if (ret < 0)
+		ULOG_ERR("%s: invalid property %s: no overlay\n", node, prop);
+	return ret;
+}
+
+static bool fortisoc_dt_compatible(const char *node)
+{
+	char buf[256];
+	ssize_t n;
+	char *p;
+
+	n = fortisoc_read_file(node, "compatible", buf, sizeof(buf) - 1);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+
+	for (p = buf; p < buf + n; p += strlen(p) + 1)
+		if (!strcmp(p, FORTISOC_COMPATIBLE))
+			return true;
+
+	return false;
+}
+
+/* Find the only matching node among the children of the root. */
+static int fortisoc_dt_find(char *node, size_t len)
+{
+	char path[FORTISOC_PATHLEN];
+	struct dirent *d;
+	struct stat st;
+	int found = 0;
+	DIR *dir;
+
+	dir = opendir(FORTISOC_DT_BASE);
+	if (!dir)
+		return -1;
+
+	while ((d = readdir(dir)) != NULL) {
+		if (d->d_name[0] == '.')
+			continue;
+
+		if (snprintf(path, sizeof(path), "%s/%s", FORTISOC_DT_BASE,
+			     d->d_name) >= (int)sizeof(path))
+			continue;
+
+		if (stat(path, &st) || !S_ISDIR(st.st_mode))
+			continue;
+
+		if (!fortisoc_dt_compatible(path))
+			continue;
+
+		if (found++) {
+			ULOG_ERR("more than one %s node\n", FORTISOC_COMPATIBLE);
+			break;
+		}
+		snprintf(node, len, "%s", path);
+	}
+
+	closedir(dir);
+
+	return found == 1 ? 0 : -1;
+}
+
+static int fortisoc_dt_read(struct fortisoc_desc *desc)
+{
+	char node[FORTISOC_PATHLEN];
+	uint64_t sectors;
+	uint32_t range[2];
+	int ret;
+
+	memset(desc, 0, sizeof(*desc));
+
+	if (fortisoc_dt_find(node, sizeof(node)))
+		return -1;
+
+	if (fortisoc_dt_check(node, "fortinet,disk-sectors",
+			      fortisoc_dt_fixed(node, "fortinet,disk-sectors",
+						&sectors, sizeof(sectors))) ||
+	    fortisoc_dt_check(node, "fortinet,rootfs-data",
+			      fortisoc_dt_fixed(node, "fortinet,rootfs-data",
+						range, sizeof(range))))
+		return -1;
+
+	/* optional, but an invalid one must not match any disk */
+	ret = fortisoc_dt_string(node, "fortinet,disk-vendor", desc->vendor);
+	if (ret > 0)
+		desc->vendor[0] = '\0';
+	else if (fortisoc_dt_check(node, "fortinet,disk-vendor", ret))
+		return -1;
+	ret = fortisoc_dt_string(node, "fortinet,disk-model", desc->model);
+	if (ret > 0)
+		desc->model[0] = '\0';
+	else if (fortisoc_dt_check(node, "fortinet,disk-model", ret))
+		return -1;
+
+	desc->disk_sectors = be64_to_cpu(sectors);
+	desc->start = be32_to_cpu(range[0]);
+	desc->count = be32_to_cpu(range[1]);
+
+	/* start and count are 32-bit: their sum cannot overflow */
+	if (!desc->start || !desc->count ||
+	    desc->start + desc->count > desc->disk_sectors) {
+		ULOG_ERR("%s: invalid range %llu+%llu on a %llu-sector disk\n",
+			 node, (unsigned long long)desc->start,
+			 (unsigned long long)desc->count,
+			 (unsigned long long)desc->disk_sectors);
+		return -1;
+	}
+
+	if (desc->start % FORTISOC_ALIGN || desc->count % FORTISOC_ALIGN) {
+		ULOG_ERR("%s: range %llu+%llu not aligned on %d sectors\n",
+			 node, (unsigned long long)desc->start,
+			 (unsigned long long)desc->count, FORTISOC_ALIGN);
+		return -1;
+	}
+
+	return 0;
+}
+
+/*
+ * The witness of the write windows of the kernel guard must show the range
+ * as the one persistent window, in a state where that window is open.
+ */
+static bool fortisoc_witness_ok(const struct fortisoc_desc *desc)
+{
+	char buf[512], want[48], *tok, *save;
+	int seen = 0, in_persistent = 0, n_persistent = 0, words = 0;
+	bool state_ok = false, match = false;
+	ssize_t n;
+	int fd;
+
+	fd = open(FORTISOC_WRITE_WINDOWS, O_RDONLY);
+	if (fd < 0) {
+		ULOG_ERR("no write window witness (%s): no overlay\n",
+			 FORTISOC_WRITE_WINDOWS);
+		return false;
+	}
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0) {
+		ULOG_ERR("empty write window witness: no overlay\n");
+		return false;
+	}
+	buf[n] = '\0';
+
+	snprintf(want, sizeof(want), "%llu+%llu",
+		 (unsigned long long)desc->start,
+		 (unsigned long long)desc->count);
+
+	for (tok = strtok_r(buf, " \t\n", &save); tok;
+	     tok = strtok_r(NULL, " \t\n", &save)) {
+		if (!words++) {
+			state_ok = !strcmp(tok, "disarmed") ||
+				   !strcmp(tok, "armed") ||
+				   !strcmp(tok, "expired");
+			continue;
+		}
+		if (!strcmp(tok, "persistent")) {
+			seen++;
+			in_persistent = 1;
+			continue;
+		}
+		if (!strcmp(tok, "sector0")) {
+			in_persistent = 0;
+			continue;
+		}
+		if (in_persistent) {
+			n_persistent++;
+			if (!strcmp(tok, want))
+				match = true;
+		}
+	}
+
+	if (!state_ok || seen != 1 || n_persistent != 1 || !match) {
+		ULOG_ERR("write window witness without the persistent window %s: no overlay\n",
+			 want);
+		return false;
+	}
+
+	return true;
+}
+
+static bool fortisoc_sys_string_eq(const char *dir, const char *name,
+				   const char *want)
+{
+	char buf[FORTISOC_STRLEN + 2];
+	ssize_t n;
+
+	if (!want[0])
+		return true;
+
+	n = fortisoc_read_file(dir, name, buf, sizeof(buf) - 1);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+	fortisoc_trim(buf);
+
+	return !strcmp(buf, want);
+}
+
+static bool fortisoc_disk_matches(const char *name,
+				  const struct fortisoc_desc *desc)
+{
+	char dir[FORTISOC_PATHLEN];
+	char buf[32];
+	struct stat st;
+	char *end;
+	ssize_t n;
+
+	if (!strncmp(name, "loop", 4) || !strncmp(name, "ram", 3) ||
+	    !strncmp(name, "mtdblock", 8) || !strncmp(name, "zram", 4))
+		return false;
+
+	if (snprintf(dir, sizeof(dir), "%s/%s", FORTISOC_SYS_BLOCK, name) >=
+	    (int)sizeof(dir))
+		return false;
+
+	/* whole disks only */
+	n = strlen(dir);
+	snprintf(dir + n, sizeof(dir) - n, "/partition");
+	if (!stat(dir, &st))
+		return false;
+	dir[n] = '\0';
+
+	n = fortisoc_read_file(dir, "size", buf, sizeof(buf) - 1);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+
+	errno = 0;
+	if (strtoull(buf, &end, 10) != desc->disk_sectors || errno ||
+	    end == buf)
+		return false;
+
+	return fortisoc_sys_string_eq(dir, "device/vendor", desc->vendor) &&
+	       fortisoc_sys_string_eq(dir, "device/model", desc->model);
+}
+
+/* Find the only whole disk matching the description. */
+static int fortisoc_disk_find(const struct fortisoc_desc *desc, char *disk,
+			      size_t len)
+{
+	struct dirent *d;
+	int found = 0;
+	DIR *dir;
+
+	dir = opendir(FORTISOC_SYS_BLOCK);
+	if (!dir)
+		return -1;
+
+	while ((d = readdir(dir)) != NULL) {
+		if (d->d_name[0] == '.')
+			continue;
+
+		if (!fortisoc_disk_matches(d->d_name, desc))
+			continue;
+
+		if (found++) {
+			ULOG_ERR("more than one disk matches %s\n",
+				 FORTISOC_COMPATIBLE);
+			break;
+		}
+
+		if (snprintf(disk, len, "%s/%s", FORTISOC_DEV_DIR, d->d_name) >=
+		    (int)len)
+			found = 2;
+	}
+
+	closedir(dir);
+
+	return found == 1 ? 0 : -1;
+}
+
+static bool fortisoc_sys_u64_eq(const char *dir, const char *name,
+				uint64_t want)
+{
+	char buf[32], *end;
+	unsigned long long val;
+	ssize_t n;
+
+	n = fortisoc_read_file(dir, name, buf, sizeof(buf) - 1);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+
+	errno = 0;
+	val = strtoull(buf, &end, 10);
+	return !errno && end != buf && (*end == '\n' || !*end) && val == want;
+}
+
+static bool fortisoc_in_preinit(void)
+{
+	struct stat st;
+
+	return getenv("PREINIT") || !stat(FORTISOC_PREINIT_FLAG, &st);
+}
+
+static bool fortisoc_dev_mounted(const char *dev)
+{
+	char line[512], src[FORTISOC_PATHLEN];
+	bool found = false;
+	FILE *f;
+
+	f = fopen(FORTISOC_PROC_MOUNTS, "r");
+	if (!f)
+		return false;
+
+	while (!found && fgets(line, sizeof(line), f))
+		found = sscanf(line, "%255s", src) == 1 && !strcmp(src, dev);
+
+	fclose(f);
+
+	return found;
+}
+
+static const char *fortisoc_basename(const char *path)
+{
+	const char *b = strrchr(path, '/');
+
+	return b ? b + 1 : path;
+}
+
+/*
+ * A loop device bound to exactly the range (offset and size limit) of the
+ * disk is mounted. The disk is matched by the base name of the backing
+ * file: sysfs shows the path as seen from the current root, and a loop
+ * device bound in preinit on the tmpfs /dev reads "/sda" once the root
+ * has been pivoted, not "/dev/sda".
+ */
+static bool fortisoc_range_mounted(const struct fortisoc_volume *p)
+{
+	char dir[FORTISOC_PATHLEN], dev[FORTISOC_PATHLEN];
+	char file[FORTISOC_PATHLEN];
+	bool found = false;
+	struct dirent *d;
+	DIR *sys;
+	ssize_t n;
+
+	sys = opendir(FORTISOC_SYS_BLOCK);
+	if (!sys)
+		return false;
+
+	while (!found && (d = readdir(sys)) != NULL) {
+		if (strncmp(d->d_name, "loop", 4))
+			continue;
+
+		if (snprintf(dir, sizeof(dir), "%s/%s/loop", FORTISOC_SYS_BLOCK,
+			     d->d_name) >= (int)sizeof(dir) ||
+		    snprintf(dev, sizeof(dev), "%s/%s", FORTISOC_DEV_DIR,
+			     d->d_name) >= (int)sizeof(dev))
+			continue;
+
+		n = fortisoc_read_file(dir, "backing_file", file,
+				       sizeof(file) - 1);
+		if (n <= 0)
+			continue;
+		file[n] = '\0';
+		fortisoc_trim(file);
+
+		found = *fortisoc_basename(file) &&
+			!strcmp(fortisoc_basename(file),
+				fortisoc_basename(p->disk)) &&
+			fortisoc_sys_u64_eq(dir, "offset", p->offset) &&
+			fortisoc_sys_u64_eq(dir, "sizelimit", p->size) &&
+			fortisoc_dev_mounted(dev);
+	}
+
+	closedir(sys);
+
+	return found;
+}
+
+static int fortisoc_volume_identify(struct volume *v)
+{
+	struct fortisoc_volume *p = container_of(v, struct fortisoc_volume, v);
+	int ret = FS_NONE;
+	FILE *f;
+
+	f = fopen(p->disk, "r");
+	if (!f)
+		return ret;
+
+	ret = block_file_identify(f, p->offset);
+
+	fclose(f);
+
+	return ret;
+}
+
+/* The ext4 filesystem of the range is labelled rootfs_data. */
+static bool fortisoc_ext4_is_overlay(struct fortisoc_volume *p)
+{
+	char label[16 + 1] = { 0 };
+	bool ret;
+	FILE *f;
+
+	f = fopen(p->disk, "r");
+	if (!f)
+		return false;
+
+	ret = !fseeko(f, p->offset + FORTISOC_EXT4_LABEL, SEEK_SET) &&
+	      fread(label, 1, 16, f) == 16 && !strcmp(label, FORTISOC_LABEL);
+
+	fclose(f);
+
+	return ret;
+}
+
+static struct volume *fortisoc_volume_find(char *name)
+{
+	struct fortisoc_volume *p;
+	struct fortisoc_desc desc;
+	struct stat st;
+	FILE *f;
+
+	if (strcmp(name, "rootfs_data") != 0)
+		return NULL;
+
+	if (fortisoc_dt_read(&desc))
+		return NULL;
+
+	if (!fortisoc_witness_ok(&desc))
+		return NULL;
+
+	p = calloc(1, sizeof(*p));
+	if (!p)
+		return NULL;
+
+	if (fortisoc_disk_find(&desc, p->disk, sizeof(p->disk)))
+		goto out;
+
+	p->v.drv = &fortisoc_driver;
+	p->v.name = "rootfs_data";
+	p->offset = desc.start * 512;
+	p->size = desc.count * 512;
+
+	/*
+	 * Outside preinit, only the overlay mounted at boot is claimed (for
+	 * firstboot, factoryreset, mount_root done): a disk that showed up
+	 * late is never formatted nor switched to under a running system.
+	 */
+	if (!fortisoc_in_preinit() && !fortisoc_range_mounted(p)) {
+		if (!stat(FORTISOC_LATE_FLAG, &st))
+			ULOG_ERR("%s showed up after preinit: no overlay on this boot, changes stay in RAM; reboot to use it\n",
+				 p->disk);
+		else
+			ULOG_INFO("%s: range not mounted, left alone outside preinit\n",
+				  p->disk);
+		goto out;
+	}
+
+	/* the sysfs entry may precede the /dev node: say so, not "no overlay" */
+	f = fopen(p->disk, "r");
+	if (!f) {
+		ULOG_ERR("cannot open %s: %s\n", p->disk, strerror(errno));
+		goto out;
+	}
+	fclose(f);
+
+	/* never claim, hence never format, a range that holds nothing known */
+	switch (fortisoc_volume_identify(&p->v)) {
+	case FS_EXT4:
+		if (fortisoc_ext4_is_overlay(p))
+			return &p->v;
+		ULOG_INFO("%s: ext4 at sector %llu not labelled %s, ignored\n",
+			  p->disk, (unsigned long long)desc.start,
+			  FORTISOC_LABEL);
+		break;
+	case FS_DEADCODE:
+	case FS_TARGZ:
+		return &p->v;
+	default:
+		/*
+		 * The described disk and range, but nothing known in it: an
+		 * interrupted first format (mkfs clears the start of the range
+		 * first) or a range never prepared. Say so loudly; formatting
+		 * it would be a new write nobody asked for.
+		 */
+		ULOG_ERR("%s: no overlay at sector %llu (no filesystem, no erase marker): running without persistent storage; restore an erase marker at the start of the range to format it\n",
+			 p->disk, (unsigned long long)desc.start);
+		break;
+	}
+
+out:
+	free(p);
+	return NULL;
+}
+
+/*
+ * Direct I/O on the loop: its writes reach the disk as bios of the
+ * range itself, never through the page cache of the whole disk, where
+ * sync(2) can leave them dirty for dirty_expire_centisecs (sync_bdevs()
+ * only waits, in its second pass, on the disk it wrote in the first).
+ * Refused (old kernel, unaligned offset, backing file without O_DIRECT):
+ * keep the buffered loop, as before, and say so.
+ */
+static void fortisoc_loop_dio(int fd, const char *name)
+{
+	if (ioctl(fd, LOOP_SET_DIRECT_IO, 1UL) != 0)
+		ULOG_WARN("%s: no direct I/O (%s), buffered loop: "
+			  "sync is not durable before writeback\n",
+			  name, strerror(errno));
+}
+
+enum fortisoc_loop_state {
+	FORTISOC_LOOP_ABSENT,	/* no such node */
+	FORTISOC_LOOP_FREE,	/* unbound */
+	FORTISOC_LOOP_OURS,	/* bound to exactly the range */
+	FORTISOC_LOOP_OTHER,	/* bound to something else */
+	FORTISOC_LOOP_CLASH,	/* bound to part of the range, or read-only */
+	FORTISOC_LOOP_UNKNOWN,	/* status unreadable */
+};
+
+/*
+ * Status of a loop device, read through a read-only descriptor: without
+ * CONFIG_BLK_DEV_WRITE_MOUNTED, the loop holding the mounted overlay
+ * refuses to open for writing (EBUSY), and skipping it would bind a
+ * second loop device to the same range.
+ */
+static enum fortisoc_loop_state
+fortisoc_loop_state(const struct fortisoc_volume *p, const char *name)
+{
+	char file[LO_NAME_SIZE + 1];
+	struct loop_info64 info;
+	enum fortisoc_loop_state ret;
+	uint64_t end;
+	int fd;
+
+	fd = open(name, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return errno == ENOENT || errno == ENXIO || errno == ENODEV ?
+			FORTISOC_LOOP_ABSENT : FORTISOC_LOOP_UNKNOWN;
+
+	if (ioctl(fd, LOOP_GET_STATUS64, &info) != 0) {
+		ret = errno == ENXIO ? FORTISOC_LOOP_FREE : FORTISOC_LOOP_UNKNOWN;
+		close(fd);
+		return ret;
+	}
+	close(fd);
+
+	memcpy(file, info.lo_file_name, LO_NAME_SIZE);
+	file[LO_NAME_SIZE] = '\0';
+	if (strcmp(file, p->disk))
+		return FORTISOC_LOOP_OTHER;
+
+	if (info.lo_offset == p->offset && info.lo_sizelimit == p->size)
+		return info.lo_flags & LO_FLAGS_READ_ONLY ?
+			FORTISOC_LOOP_CLASH : FORTISOC_LOOP_OURS;
+
+	/* same disk: any overlap with the range is an alias of it */
+	end = info.lo_sizelimit ? info.lo_offset + info.lo_sizelimit : UINT64_MAX;
+	if (info.lo_offset < p->offset + p->size && end > p->offset)
+		return FORTISOC_LOOP_CLASH;
+
+	return FORTISOC_LOOP_OTHER;
+}
+
+/* Bind the free loop device name to the range; 0 on success. */
+static int fortisoc_bind_loop(struct fortisoc_volume *p, const char *name)
+{
+	struct loop_info64 info;
+	int fd, ffd, ret = -1;
+
+	fd = open(name, O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+
+	/* still free: never rebind a loop device that got bound meanwhile */
+	if (ioctl(fd, LOOP_GET_STATUS64, &info) == 0 || errno != ENXIO)
+		goto out;
+
+	ffd = open(p->disk, O_RDWR | O_CLOEXEC);
+	if (ffd < 0) {
+		ULOG_ERR("cannot open %s: %s\n", p->disk, strerror(errno));
+		goto out;
+	}
+
+	if (ioctl(fd, LOOP_SET_FD, ffd) != 0) {
+		close(ffd);
+		goto out;
+	}
+	close(ffd);
+
+	memset(&info, 0, sizeof(info));
+	memcpy(info.lo_file_name, p->disk, strlen(p->disk) + 1);
+	info.lo_offset = p->offset;
+	info.lo_sizelimit = p->size;
+	info.lo_flags |= LO_FLAGS_AUTOCLEAR;
+
+	if (ioctl(fd, LOOP_SET_STATUS64, &info) != 0) {
+		ioctl(fd, LOOP_CLR_FD, 0);
+		goto out;
+	}
+
+	/* after LOOP_SET_STATUS64, which cannot set the flag (offset known) */
+	fortisoc_loop_dio(fd, name);
+
+	/*
+	 * Keep the loop device open until this process exits, to avoid
+	 * the autoclear from happening too soon, but read-only: a kernel
+	 * built without CONFIG_BLK_DEV_WRITE_MOUNTED refuses to mount a
+	 * block device that still has a writer (EBUSY). The writable
+	 * descriptor was only needed to bind the loop read-write.
+	 */
+	if (open(name, O_RDONLY | O_CLOEXEC) < 0) {
+		ULOG_ERR("cannot reopen %s: %s\n", name, strerror(errno));
+		ioctl(fd, LOOP_CLR_FD, 0);
+		goto out;
+	}
+
+	ret = 0;
+out:
+	close(fd);
+	return ret;
+}
+
+/*
+ * Reuse the loop device already bound to the range (the mounted overlay,
+ * for firstboot or factoryreset), else bind a free one. Never a second
+ * one: a loop device whose status cannot be read, or that maps part of
+ * the range, makes this fail instead.
+ */
+static int fortisoc_create_loop(struct fortisoc_volume *p)
+{
+	enum fortisoc_loop_state state[FORTISOC_LOOPS];
+	char name[FORTISOC_PATHLEN];
+	int i, ours = -1, fd;
+
+	/* the loop device records the path: a truncated one never matches */
+	if (strlen(p->disk) >= LO_NAME_SIZE) {
+		ULOG_ERR("%s: path longer than %d bytes, not bound to a loop device\n",
+			 p->disk, LO_NAME_SIZE - 1);
+		return -1;
+	}
+
+	for (i = 0; i < FORTISOC_LOOPS; i++) {
+		snprintf(name, sizeof(name), "%s/loop%d", FORTISOC_DEV_DIR, i);
+		state[i] = fortisoc_loop_state(p, name);
+
+		switch (state[i]) {
+		case FORTISOC_LOOP_OURS:
+			if (ours >= 0) {
+				ULOG_ERR("%s: range bound to two loop devices\n",
+					 p->disk);
+				return -1;
+			}
+			ours = i;
+			break;
+		case FORTISOC_LOOP_CLASH:
+			ULOG_ERR("%s: maps part of the range of %s, or read-only\n",
+				 name, p->disk);
+			return -1;
+		case FORTISOC_LOOP_UNKNOWN:
+			if (ours < 0)
+				ULOG_WARN("%s: status unreadable (%s)\n", name,
+					  strerror(errno));
+			break;
+		default:
+			break;
+		}
+	}
+
+	if (ours >= 0) {
+		snprintf(p->loop_name, sizeof(p->loop_name), "%s/loop%d",
+			 FORTISOC_DEV_DIR, ours);
+		/* read-only: LOOP_SET_DIRECT_IO only needs CAP_SYS_ADMIN */
+		fd = open(p->loop_name, O_RDONLY | O_CLOEXEC);
+		if (fd >= 0) {
+			fortisoc_loop_dio(fd, p->loop_name);
+			close(fd);
+		}
+		return 0;
+	}
+
+	for (i = 0; i < FORTISOC_LOOPS; i++)
+		if (state[i] == FORTISOC_LOOP_UNKNOWN) {
+			ULOG_ERR("a loop device may hold the range of %s: no second binding\n",
+				 p->disk);
+			return -1;
+		}
+
+	for (i = 0; i < FORTISOC_LOOPS; i++) {
+		if (state[i] != FORTISOC_LOOP_FREE)
+			continue;
+		snprintf(name, sizeof(name), "%s/loop%d", FORTISOC_DEV_DIR, i);
+		if (!fortisoc_bind_loop(p, name)) {
+			snprintf(p->loop_name, sizeof(p->loop_name), "%s", name);
+			return 0;
+		}
+	}
+
+	p->loop_name[0] = 0;
+	return -1;
+}
+
+static int fortisoc_volume_init(struct volume *v)
+{
+	struct fortisoc_volume *p = container_of(v, struct fortisoc_volume, v);
+
+	if (!p->loop_name[0] && fortisoc_create_loop(p) != 0) {
+		ULOG_ERR("unable to create loop device\n");
+		return -1;
+	}
+
+	v->type = BLOCKDEV;
+	v->size = p->size;
+	v->blk = p->loop_name;
+
+	/* the loop device is bounded to the range: its whole size is usable */
+	return block_volume_format(v, 0, v->blk);
+}
+
+static struct driver fortisoc_driver = {
+	.name = "fortisoc",
+	.priority = 40,
+	.find = fortisoc_volume_find,
+	.init = fortisoc_volume_init,
+	.identify = fortisoc_volume_identify,
+};
+
+DRIVER(fortisoc_driver);
