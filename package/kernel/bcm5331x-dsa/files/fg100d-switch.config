# SPDX-License-Identifier: GPL-2.0-only
# BCM53314 switch of the FortiGate 100D, set up at boot by
# /etc/init.d/fg100d-switch (read at the next boot).
config switch 'switch'
	# 0: nothing is loaded at boot, the switch is left as found and
	# the front ports have no network device
	option enabled '1'
	# LED set-up of the PHYs of port1-16 (link speed and activity LEDs)
	option phyled '1'
	# double tagging (802.1ad outer tag on the CPU link): user VLANs on
	# the front ports and VLAN-aware bridges; 0 refuses VLAN filtering
	option qinq '1'
	# start from the disk only: 1 hands the LEDs of wan2, MGMT, ha1 and
	# ha2 to the LED processor of the switch, which does not run then
	# (they stay lit); 0 leaves them to their PHYs (link and activity)
	option ledram '0'
	# Options of the DSA driver bcm5331x-dsa (read at the next boot, a
	# bad combination loads nothing): hwbridge, fdb, vlanbr, lagf and mgmt
	# on when absent, the others off when absent.
	# hardware bridging: VLAN-unaware bridges of front ports forwarded by
	# the switch (bcm5331x-dsa hwbridge); 0 = software bridge
	#option hwbridge '1'
	# address table of the offloaded bridges (fdb, needs hwbridge)
	#option fdb '1'
	# first VLAN-aware bridge of front ports offloaded too (vlanbr, needs
	# hwbridge and qinq)
	#option vlanbr '1'
	# ge3 as a second CPU link and conduit LAG (lag; steps ge3,trunk2;
	# not with mgmt; the bond of eth0 and eth1 is left to the network
	# configuration and needs the bonding driver)
	#option lag '0'
	# hardware LAG of front ports in an offloaded bridge (lagf, needs
	# hwbridge): 1 = trunk group, 2 = + LACP frames on the port VID;
	# 0 = software LAG
	#option lagf '2'
	# link-local protocols of the members of offloaded bridges on the
	# port VID (llproto, needs hwbridge), mask: 1 = STP (the bridge's STP
	# works without bpdu_filter), 2 = LLDP, 4 = EAPOL; 0 = dropped in the
	# bridge VLAN
	#option llproto '0'
	# multicast groups of the offloaded bridges (mdb, needs fdb): static
	# groups of non-designated ports and host groups forwarded by the
	# switch (L2MC), IGMP/MLD always flooded to the host; 0 = flooded
	#option mdb '0'
	# MGMT as the DSA user port "mgmt" (port VID 20; interface mgmt of
	# /etc/config/network, unconfigured): step mgmt of the base module
	# (twelve switch writes) and auto-negotiation of the MGMT PHY; 0
	# leaves MGMT out of DSA, as found (needed for option lag)
	#option mgmt '1'
	# offload of tc matchall mirred between front ports (mirror)
	#option mirror '0'
	# hardware statistics of the front ports and ge2 from the MIB (reads
	# only); 0 = stats_ms=0, the software counters of DSA; stats_ms:
	# period in ms, 1000-30000 (module default 10000)
	#option stats '0'
	#option stats_ms '10000'
	# link of the front ports: 1 = EPC_LINK_BMAP follows the link, 2 = 1
	# + real port PHYs for ethtool -s and the MAC speed, duplex and pause
	#option link '0'
	# first VID of the block of the front-port VLANs (vid_base, 21-3976):
	# port VIDs vid_base+1..+22, bridge VIDs vid_base+41..+48; 100 = VIDs
	# 101-122 and 141-148, not passed
	#option vid_base '100'
	# QoS offloaded to the switch: DCB, tc ets, tc tbf, flower storm
	# control of the front ports (qos, also /sys/module/bcm5331x_dsa/
	# parameters/qos at run time); 0 = nothing written
	#option qos '0'
	# tc flower, matchall police and ethtool ntuple rules of the front
	# ports on the Field Processor (fp, also at run time like qos); 0 =
	# nothing written
	#option fp '0'
	# time stamping (ptp): 1 = debugfs ptp (reads only), 2 = 1 + PTP
	# clock on the CMIC timer, 3 = 2 + ge2 ingress stamping armed for a
	# capture; 0 = nothing read or written. No PTP frame reaches the host
	#option ptp '0'
	# ptp 2-3: picoseconds a tick of the CMIC timer, 500-100000
	#option ptp_tick_ps '1000'
	# Packet DMA of the CMIC, a test aid only: nothing it receives
	# reaches the network stack, no feature depends on it. 0 = no access
	# at all; 2 = stage cmic_stage. Every value below is left out of the
	# load and not checked unless cmic is 2. After "not stopped" or
	# "memory left" in the kernel log, cut the power: a channel that did
	# not stop can still write to RAM. cmic_stage 4 has no time limit, is
	# replayed at each boot by this file, and with the cmic_rx_act
	# default (3) it drops the broadcasts of port1.
	#option cmic '0'
	# 1 = sequence only, 2 = + test frames sent, 3 = + one receive
	# descriptor, 4 = + chain of receive descriptors (3 and 4 need
	# hwbridge 0 and link 0; hwbridge stays on unless set to 0 here)
	#option cmic_stage '1'
	# cmic_stage 2: switch port of the test frames (a front port, 5 or 7-24,
	# 10 = port1) and their number, 1-8
	#option cmic_tx_port '10'
	#option cmic_tx_count '1'
	# cmic_stage 3-4: longest wait in ms (1000-120000), DA of the test entry
	# L2_USER_ENTRY[39] (0x1-0xffffffffffff), its VID (-1 = VID of port1,
	# 0 = VID out of the mask, else 1-4094), its actions (1 CPU, 2
	# DST_DISCARD, 4 BPDU; 0 = no entry), CMIC port added to the VLAN of
	# port1 while the channel runs (1)
	#option cmic_rx_ms '30000'
	#option cmic_rx_da '0xffffffffffff'
	#option cmic_rx_vid '-1'
	#option cmic_rx_act '3'
	#option cmic_cpu_vlan '0'
