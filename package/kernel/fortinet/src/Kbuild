# Out-of-tree Kbuild of the Fortinet network processor and crypto engine
# drivers (package/kernel/fortinet). It replaces the Kconfig and Makefile
# hooks of the in-tree build: the package Makefile selects what to build
# with the variables below, passed on the make command line.
#
#   FORTINET_SOC       fsoc1, fsoc2 or fsoc3 (sub-target)
#   FORTINET_NP4LITE   m to build fortinet-np4lite.ko
#   FORTINET_NP6LITE   m to build fortinet-np6lite.ko
#   FORTINET_CP7       m to build fortinet-cp7.ko
#
# The options of the in-tree Kconfig that the code still tests are defined
# here as plain macros (IS_ENABLED() and #ifdef both see them).

ccflags-y += -I$(src)/include

# Options of the NP4Lite driver, as set by the in-tree configuration of the
# sub-target. Only the FortiSOC2 has the IPsec engine behind the network
# processor and a switch behind its links. The kernel configuration is
# visible here (include/config/auto.conf): each option is only turned on
# when the kernel has what its in-tree Kconfig entry depends on.
np4lite-defs := -DCONFIG_FORTINET_NP4LITE_RX_RING_LEN=4096 \
		-DCONFIG_FORTINET_NP4LITE_NAPI_WEIGHT=64

ifeq ($(FORTINET_SOC),fsoc2)
ifneq ($(CONFIG_NET_DSA),)
ifneq ($(CONFIG_NET_DSA_TAG_BRCM),)
np4lite-defs += -DCONFIG_FORTINET_NP4LITE_DSA=1
endif
endif
ifneq ($(CONFIG_BONDING),)
np4lite-defs += -DCONFIG_FORTINET_NP4LITE_LAG=1
endif
ifeq ($(CONFIG_XFRM_OFFLOAD),y)
ifneq ($(CONFIG_INET_ESP_OFFLOAD),)
np4lite-defs += -DCONFIG_FORTINET_NP4LITE_IPSEC=1
np4lite-ipsec-obj := np4lite/np4lite-ipsec.o
ifeq ($(CONFIG_NF_FLOW_TABLE_XFRM_OFFLOAD),y)
np4lite-defs += -DCONFIG_FORTINET_NP4LITE_IPSEC_FLOWS=1
endif
endif
endif
ifeq ($(np4lite-ipsec-obj),)
$(warning NP4Lite IPsec offload left out: no XFRM_OFFLOAD or INET_ESP_OFFLOAD)
endif
endif

# Options of the NP6Lite driver.
np6lite-defs := -DCONFIG_FORTINET_NP6LITE_POLL_MS=0 \
		-DCONFIG_FORTINET_NP6LITE_FLOW_OFFLOAD=1

# Per-object flags are keyed by the path of the object below this directory.
CFLAGS_np4lite/np4lite-core.o := $(np4lite-defs)
CFLAGS_np4lite/np4lite-ipsec.o := $(np4lite-defs)
CFLAGS_np6lite/np6lite-core.o := $(np6lite-defs)

# NP4Lite: the port driver; on the FortiSOC2, the IPsec engine glue too.
obj-$(FORTINET_NP4LITE) += fortinet-np4lite.o
fortinet-np4lite-y := np4lite/np4lite-core.o $(np4lite-ipsec-obj)

# NP6Lite: host interface and MDIO master.
obj-$(FORTINET_NP6LITE) += fortinet-np6lite.o
fortinet-np6lite-y := np6lite/np6lite-core.o

# CP7: crypto engine (FortiSOC1 and FortiSOC2 only).
obj-$(FORTINET_CP7) += fortinet-cp7.o
fortinet-cp7-y := cp7.o
